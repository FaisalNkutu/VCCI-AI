package com.calian.aicoredata;

import com.calian.rabbitmq.comms.BTO;

import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.UUID;

public class GetCommandsRequest extends BTO {

    private HashMap<String, List<String>> jCommandData = new HashMap<>();
    private UUID jClientID = null;

    public GetCommandsRequest() {
    }

    public GetCommandsRequest(UUID clientID) {
        jClientID = clientID;
    }

    public void setCommandData(HashMap<String, List<String>> commandData) {
        this.jCommandData = commandData;
    }

    public HashMap<String, List<String>> getCommandData() {
        return jCommandData;
    }

    public UUID getClientID() {
        return jClientID;
    }

}
