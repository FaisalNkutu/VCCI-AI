package com.calian.paradigm.service.aiservice.cohere;

/**
 * Exception thrown when automatic AI agent routing fails.
 *
 * This is a checked exception so callers of AgentRouterClient
 * must explicitly handle routing and communication failures.
 *
 * @author F. Nkutu
 * @company SimFront a Calian Company
 * Created 2026
 */
public class AgentRoutingException extends Exception {

    private static final long serialVersionUID = 1L;

    /**
     * Creates an AgentRoutingException with an error message.
     *
     * @param message description of the routing failure
     */
    public AgentRoutingException(String message) {
        super(message);
    }

    /**
     * Creates an AgentRoutingException with an error message
     * and the original exception that caused the failure.
     *
     * @param message description of the routing failure
     * @param cause original exception
     */
    public AgentRoutingException(String message, Throwable cause) {
        super(message, cause);
    }

    /**
     * Creates an AgentRoutingException from an underlying exception.
     *
     * @param cause original exception
     */
    public AgentRoutingException(Throwable cause) {
        super(cause);
    }
}
