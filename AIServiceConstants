package com.calian.paradigm.service.aiservice.resources;

import java.io.BufferedReader;
import java.io.InputStream;
import java.io.InputStreamReader;
import java.nio.charset.StandardCharsets;

/**
 * AI Service configuration constants.
 *
 * @author F. Nkutu
 * @company SimFront a Calian Company
 * Created 2026
 */
public final class AIServiceConstants {

    public static final String ROUTER_URL = loadRouterURL();

    private AIServiceConstants() {
    }

    private static String loadRouterURL() {
        try (InputStream input = AIServiceConstants.class.getClassLoader().getResourceAsStream("application.yml")) {

            if (input == null) {
                throw new IllegalStateException("application.yml not found on classpath.");
            }

            try (BufferedReader reader = new BufferedReader(new InputStreamReader(input, StandardCharsets.UTF_8))) {

                String line;

                while ((line = reader.readLine()) != null) {

                    String trimmedLine = line.trim();

                    if (trimmedLine.startsWith("ROUTER_URL:")) {

                        String value = trimmedLine.substring("ROUTER_URL:".length()).trim();

                        if (value.isBlank()) {
                            throw new IllegalStateException("ROUTER_URL is empty in application.yml.");
                        }

                        return value;
                    }
                }
            }

            throw new IllegalStateException("ROUTER_URL is missing from application.yml.");

        } catch (Exception ex) {
            throw new IllegalStateException("Failed to load ROUTER_URL from application.yml.", ex);
        }
    }
}

