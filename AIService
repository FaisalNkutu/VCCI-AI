    /**
     * This method is used to execute time service feature requests
     *
     * @param frr A reference to the feature request response object
     */
    @Override
    public void executeFeatureRequest(FeatureRequestResponse frr) {
        try {
            switch (frr.getComponentFeatureID()) {
                case CONNECT:
                    processConnect(frr);
                    break;

                case REGISTER:
                    processRegister(frr);
                    break;

                case DEREGISTER:
                    processDeregister(frr);
                    break;

                case LIST:
                    processList(frr);
                    break;

                case USER_REQUEST:
                    processUserRequest(frr);
                    break;

                case CLEAR:
                    processClear(frr);
                    break;

                default: {
                    throw new Exception("Unknown component feature ID : " + frr);
                }
            }
        } catch (Throwable th) {
            frr.setState(FeatureRequestResponse.State.EXECUTE_FAILED);
            deliverFeatureResponse(frr);
            jL.error("Error processing Execute Feature Request", th);
        }
    }

    private AIClient getClient(FeatureRequestResponse frr) {
        String clientName = frr.getSrcClientName();
        AIClient client = jClients.get(clientName);
        if (client == null) {
            client = new AIClient();
            client.jClientName = clientName;
        }
        return client;
    }

    private void processConnect(FeatureRequestResponse frr) {
        if (jRabbitMQComm == null) {
            jRabbitMQComm = new RabbitMQComm(null);
            jDTOProcessor = new DTOProcessor(this);
            jRabbitMQComm.establishCommunication(MODEL_VERSION, jDTOProcessor);
        }
        frr.setState(FeatureRequestResponse.State.EXECUTED);
        deliverFeatureResponse(frr);
    }

    private void processConnect() {
        if (jRabbitMQComm == null) {
            jRabbitMQComm = new RabbitMQComm(null);
            jDTOProcessor = new DTOProcessor(this);
            jRabbitMQComm.establishCommunication(MODEL_VERSION, jDTOProcessor);
        }
    }

    private void prepRequest(com.calian.rabbitmq.comms.BTO request, FeatureRequestResponse frr) {
        request.setMessageTracker(UUID.randomUUID().toString());
        AIClient client = getClient(frr);
        jRequestClient.put(request.getMessageTracker(), client);
        client.jPendingRequests.put(request.getMessageTracker(), frr);
    }

    private void processRegister(FeatureRequestResponse frr) throws IOException {
        RegistrationRequest request = new RegistrationRequest();
        prepRequest(request, frr);
        sendData(request);
    }

    public void completeRegister(RegistrationRequest req) throws IOException {
        AIClient client = jRequestClient.remove(req.getMessageTracker());
        client.jClientRegistration = req.getClientID();
        FeatureRequestResponse frr = client.jPendingRequests.remove(req.getMessageTracker());
        AISRegistrationRequest aiReq = (AISRegistrationRequest) frr.getFeatureParameters();
        aiReq.setClientID(req.getClientID());
        frr.setFeatureResult(aiReq);
        frr.setState(FeatureRequestResponse.State.EXECUTED);
        deliverFeatureResponse(frr);
    }

    private void processDeregister(FeatureRequestResponse frr) throws IOException {
        EndRegistrationRequest request = new EndRegistrationRequest();
        prepRequest(request, frr);
        sendData(request);
    }

    public void completeDeregister(EndRegistrationRequest req) throws IOException {
        AIClient client = jRequestClient.remove(req.getMessageTracker());
        client.jClientRegistration = null;
        FeatureRequestResponse frr = client.jPendingRequests.remove(req.getMessageTracker());
        AISEndRegistrationRequest frrResponse = (AISEndRegistrationRequest) frr.getFeatureParameters();
        frr.setFeatureResult(frrResponse);
        frr.setState(FeatureRequestResponse.State.EXECUTED);
        deliverFeatureResponse(frr);
    }

