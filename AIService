    /**
     * This method called when another component in the System publishes an
     * object that is of interest to this component.
     *
     * @param brokerKey The key of the broker from which the object was
     * published
     * @param srcComponentID The component ID that published the object
     * @param clazz The class name of the object that was published
     * @param obj A reference to the object that was published
     */
    @Override
    public void processPublishedObjectNotification(
            BrokerKey brokerKey, String srcComponentID,
            Class<?> clazz, BTO obj) {
        if (!(obj instanceof SystemState)) {
            super.processPublishedObjectNotification(brokerKey, srcComponentID, clazz, obj);
            //dont suspend the component
        }
    }

    /**
     * This method will create a DB Writer to the OMDB so that data can be
     * inserted and cached as required
     *
     * @return true if the DB Writer could be created, false otherwise
     */
    protected boolean connectToOMDBDatabase() {
        DBWriterConnectResult result = OMAdaptor.getDBWriter(this);
        if (result.jSuccessful) {
            jDBWriter = result.jWriter;
        }
        return result.jSuccessful;
    }

    /**
     * Called when the configuration of the db writer needs to change
     *
     * @param notification, the DB writer change notification
     */
    protected void processDBWriterChangeNotification(DBWriterChangeNotification notification) {
        if (jDBWriter != null) {
            jDBWriter.processDBWriterChangeNotification(notification);
        }
    }

    public String getIdentificationId() {
        return jRabbitMQComm.getRabbitMQConfig().APP_IDENT_ID;
    }

    public void sendData(DataTransferObject dto) throws IOException {
        jRabbitMQComm.sendData(dto);
    }

    public void sendData(com.calian.rabbitmq.comms.BTO bto) throws IOException {

        DataTransferObject.Header header = jRabbitMQComm.getDTOHeader();
        header.setBindingKey(bto.getClass().getCanonicalName());
        header.setRoundTrip(true);
        header.setTarget("aicore");
        header.setTargetSegment("clientagent");
        header.setSourceSegment(null);
        DataTransferObject dto = new DataTransferObject(header, bto, MODEL_VERSION);
        // send the info to rabbit or some sender
        jRabbitMQComm.sendData(dto);
    }
