    private void processUserRequest(FeatureRequestResponse frr) throws IOException {
        AISUserRequest air = (AISUserRequest) frr.getFeatureParameters();
        UserRequest request = new UserRequest();
        request.setSendOneResponse(air.isSingleResponse());
        request.setClientID(air.getClientID());
        ArrayList<CommandObject> obj = new ArrayList<>();
        for (String cmd : air.getCommands()) {
            CommandObject co = new CommandObject(cmd);
            co.addDataObject(air.getDataType(cmd));
            co.setSchema(air.getSchema(cmd));
            obj.add(co);
        }
        request.setCommands(obj);
        prepRequest(request, frr);
        sendData(request);
    }

    public void completeUserRequest(UserRequest request) {
        AIClient client = jRequestClient.remove(request.getMessageTracker());
        FeatureRequestResponse frr = client.jPendingRequests.remove(request.getMessageTracker());
        AISUserRequest frrResponse = (AISUserRequest) frr.getFeatureParameters();
        for (CommandObject cmd : request.getCommands()) {
            List<? extends com.calian.rabbitmq.comms.BTO> response = request.getResponse(cmd.getCommand());
            for (com.calian.rabbitmq.comms.BTO bto : response) {
                frrResponse.addResponse(cmd.getCommand(), bto);
            }
        }
        frr.setFeatureResult(frrResponse);
        frr.setState(FeatureRequestResponse.State.EXECUTED);
        deliverFeatureResponse(frr);

    }

    private void processClear(FeatureRequestResponse frr) throws IOException {
        AISClearCacheRequest feat = (AISClearCacheRequest) frr.getFeatureParameters();
        ClearCacheRequest request = new ClearCacheRequest(feat.getClientID());
        prepRequest(request, frr);
        sendData(request);

    }

    public void completeClearCacheRequest(ClearCacheRequest request) {
        AIClient client = jRequestClient.remove(request.getMessageTracker());
        FeatureRequestResponse frr = client.jPendingRequests.remove(request.getMessageTracker());
        AISClearCacheRequest frrResponse = (AISClearCacheRequest) frr.getFeatureParameters();
        frrResponse.setClientID(request.getClientID());
        frr.setFeatureResult(frrResponse);
        frr.setState(FeatureRequestResponse.State.EXECUTED);
        deliverFeatureResponse(frr);

    }

