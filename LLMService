import static com.calian.aicore.AIConstants.TEXT;


public class LLMService {

    public static Logger jL = Log.getLogger(LLMService.class);
    private final HttpClient jHttpClient;
    private final ObjectMapper jMapper = new ObjectMapper();

    private final String jModel;

    public LLMService(HttpClient httpClient, String model) {
        jHttpClient = httpClient;
        jModel = model;
    }

    public synchronized LLMSelectionResponse analyze(LLMMessage message) {

        try {

            String messageString = jMapper.writeValueAsString(message);

            String prompt = """
                    You are an AI orchestration engine.
                    
                    Your task is to suggest which available agents are most appropriate for fulfilling the user's request.
                    
                    You may ONLY select numeric IDs from the jAgentMap list. DO NOT RETURN ANY NUMBER OUTSIDE OF THE MAP.
                    
                    IMPORTANT:
                    - Return only IDs that explicitly exist in AVAILABLE AGENTS
                    - Do not invent IDs
                    - Do not invent agent names
                    - Multiple agents may be selected if needed
                    - If no suitable agents exist, return success=false
                    
                    You must also suggest which types of data objects are needed for input in the selected agents. These
                    are found on the AgentCard of the selected agents.
                    
                    IMPORTANT:
                    - Only give data object TYPES (TEXT, AUDIO, IMAGE, etc.) accepted by selected agent(s)
                    - Do NOT invent actual data objects
                    
                    Return ONLY valid JSON.
                    DO NOT include markdown.
                    DO NOT include explanations.
                    DO NOT INCLUDE EXPLANATION OR ANYTHING OTHER THAN THE JSON BELOW!!!!!!
                    
                    OUTPUT FORMAT (STRICT JSON ONLY):
                    
                    SUCCESS CASE:
                    {
                      "success": true,
                      "agents": [list of selected agent ids],
                      "inputTypes": [text, audio, image],
                      "error": null
                    }
                    
                    FAILURE CASE:
                    {
                      "success": false,
                      "agents": [],
                      "inputTypes": [],
                      "error": "Explanation of why no agents can handle the request",
                    }
                    
                    CONTEXT:
                    %S
                    """.formatted(messageString);

            String rawResponse = ask(prompt);

            if (rawResponse != null) {
                return parseAgentSelection(rawResponse, message.getAgentMap());
            }

        } catch (Exception e) {
            jL.error("Could not parse LLM message: {}", e.getMessage());
        }
        return null;
    }

    private synchronized String ask(String prompt) {

        try {

            String requestBody = """
                    {
                      "model": "%s",
                      "prompt": "%s",
                      "stream": false
                    }
                    """.formatted(
                    jModel,
                    escapeJson(prompt)
            );
            jL.info("Sending request to LLM...");

            HttpRequest<String> request =
                    HttpRequest.POST(
                            "/api/generate",
                            requestBody
                    ).contentType(MediaType.APPLICATION_JSON);

            String response = jHttpClient.toBlocking().retrieve(request);

            JsonNode root = jMapper.readTree(response);

            String llmResponse = root.get("response").asText();

            return normalize(llmResponse);

        } catch (Exception e) {

            jL.error("Could not connect to LLM: {}", e.getMessage());
        }
        return null;
    }

    //ask the llm whether a data object is valid for the current use case
    public synchronized List<String> isValidDataObject(List<AIObject> dto, AgentCard ac) {
        try {


            String dtoString = parseObjects(dto);
            String agentString = jMapper.writeValueAsString(ac);

            String prompt = """
                    Your task is ONLY to determine which AIObjects are valid inputs for the supplied AgentCard.
                    Your response MUST be ONLY ONE valid JSON object. DO NOT DESCRIBE THE INPUT JUST USE IT IN THE COMPARISON.
                    
                    
                    
                    Do NOT perform any task described by the AIObjects.
                    Do NOT explain your reasoning.
                    Do NOT ask questions.
                    Do NOT make recommendations.
                    Do NOT produce markdown.
                    Do NOT return anything other one JSON object.
                    
                    ****IMPORTANT******
                    Your response MUST be exactly one valid JSON object.
                    
                    Evaluation rules:
                    
                    For each AIObject independently:
                    
                    1. Examine its type.
                    2. Examine its contents.
                    3. Examine the AgentCard capabilities.
                    4. Determine whether the object is a logical input for at least one capability of the agent.
                    
                    For AUDIO, IMAGE, VIDEO and other binary objects:
                    
                    DO NOT inspect the encoded data.
                    
                    An object is VALID only if:
                    - its type is compatible with the agent
                    - its contents are relevant to the agent
                    - the agent could reasonably consume that object as input
                    
                    If information is missing or uncertain, treat the object as INVALID.
                    
                    Collect the jObjectUniqueID of every valid object.
                    
                    If one or more objects are valid return:
                    
                    {
                      "success": true,
                      "ids": [<valid ids>]
                    }
                    
                    If no objects are valid return:
                    
                    {
                      "success": false,
                      "ids": []
                    }
                    
                    Return ONLY ONE of these TWO JSON objects.
                    
                    The following JSON contains one or more AIObjects. Use these only to decide which of the two possible answers to return.
                    
                    AIOBJECTS_START
                    %s
                    AIOBJECTS_END
                    
                    AGENTCARD_START
                    %s
                    AGENTCARD_END
                    """.formatted(dtoString, agentString);

            String rawResponse = ask(prompt);
            if (rawResponse != null) {
                return extractValidObjectResponse(rawResponse);
            }

        } catch (Exception e) {
            jL.error("Could not jsonify LLM message: {}", e.getMessage());
        }
        return null;
    }

    private static List<String> extractValidObjectResponse(String response) throws JsonProcessingException {
        int start = response.indexOf('{');
        int end = response.lastIndexOf('}');

        if (start == -1 || end == -1 || end <= start) {
            throw new IllegalArgumentException("No JSON found in response.");
        }
        JsonNode root = new ObjectMapper().readTree(response.substring(start, end + 1));

        List<String> ids = new ArrayList<>();

        for (JsonNode id : root.path("ids")) {
            ids.add(id.asText());
        }

        return ids;
    }

    private String parseObjects(List<AIObject> list) throws JsonProcessingException {
        ArrayNode routingObjects = jMapper.createArrayNode();

        for (AIObject obj : list) {

            ObjectNode node = jMapper.createObjectNode();

            node.put("id", obj.getObjectUniqueID().toString());
            node.put("type", obj.getDataType().name());

            routingObjects.add(node);
        }
        return jMapper.writerWithDefaultPrettyPrinter()
                .writeValueAsString(routingObjects);
    }

    private LLMSelectionResponse parseAgentSelection(String raw, HashMap<Integer, String> agentMap) {

        try {

            String json = extractJson(raw);

            LLMSelectionResponse response =
                    jMapper.readValue(
                            json,
                            LLMSelectionResponse.class
                    );

            if (response.getAgents() == null) {
                response.setAgents(new ArrayList<>());
            }

            if (response.getRequiredDataTypes() == null) {
                response.setRequiredDataTypes(new ArrayList<>());
            }

            ArrayList<String> agents = new ArrayList<>();
            for (Integer agent : response.getAgents()) {
                agents.add(agentMap.get(agent));
            }
            response.setSelectedAgents(agents);

            return response;

        } catch (Exception e) {

            jL.warn("Could not parse LLM response: {}", e.getMessage());
        }
        return null;
    }

    private boolean parseBooleanResponse(String raw) {

        String clean =
                raw.trim()
                        .toLowerCase();

        if (clean.contains("true")) {
            return true;
        }

        if (clean.contains("false")) {
            return false;
        }

        jL.warn("Could not parse LLM boolean response: {}", raw);
        return false;
    }

    /*
     * =========================================================
     * HELPERS
     * =========================================================
     */

    private String extractJson(String raw) {

        int start = raw.indexOf("{");

        int end = raw.lastIndexOf("}");

        if (start == -1 || end == -1) {
            jL.warn("Could not parse LLM response - no valid JSON found: {}", raw);
        }

        return raw.substring(
                start,
                end + 1
        );
    }

    private String normalize(String raw) {

        return raw
                .replace("```json", "")
                .replace("```", "")
                .trim();
    }


    private String escapeJson(String text) {

        return text
                .replace("\\", "\\\\")
                .replace("\"", "\\\"")
                .replace("\n", "\\n")
                .replace("\r", "\\r");
    }
}

