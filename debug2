    @Override
    public void initializeMicroservice() {
        jAiCoreDBManager.setMicroService(this);
        jAiCoreDBManager.loadStoredData();
        super.initializeMicroservice();
        jClientAgentHandler = new ClientAgentHandler(this, jAgentBoardMetrics, jClientBoardMetrics);
        jResponseExecutor.submit(this::processResponseQueueLoop);
        jTCPExecutor.submit(this::processTCPObjectQueue);
        startTCPServer();
    }

    private void startTCPServer() {
        InetAddress ip = null;
        try {
            ip = InetAddress.getLocalHost();
        } catch (UnknownHostException e) {
            jL.error("Error getting local host: {}", e.getMessage());
        }
        if (ip != null) {
            jTCPServer = new JSONTCPServer(ip.getHostAddress(), AIConstants.TCP_PORT, this);
            new Thread(jTCPServer).start();
            jL.info("TCP Server listening on {}:{}", ip.getHostAddress(), AIConstants.TCP_PORT);
        } else {
            jL.error("Error starting TCP server - could not retrieve local host.");
        }
    }

    @Override
    public ArrayList<String> getReceiveBindings() {
        ArrayList<String> args = new ArrayList<>();
        args.add("#");
        return args;
    }

    /***
     * This method is started by the executor thread to send out
     * responses.
     */
    private void processResponseQueueLoop() {

        while (jServiceRunning.get()) {
            try {
                //block until something arrives
                DataTransferObject dto = jResponseQueue.poll(500, TimeUnit.MILLISECONDS);
                if (dto != null) {
                    processSendResponse(dto);
                    jClientBoardMetrics.requestOut();
                }

            } catch (InterruptedException e) {
                Thread.currentThread().interrupt();
            } catch (IOException e) {
                jClientBoardMetrics.requestFailed();
                jL.error("Could not send data transfer object: {}", e.getMessage());
            }
        }

    }

    /**
     * Add worker id to dto message tracker for sending responses later.
     *
     * @param dto      - object received via TCP
     * @param workerID - worker id of the tcp client handler thread
     */
    private void addTCPTag(DataTransferObject dto, String workerID) {
        if (dto.getMessageTracker() != null) {
            String id = dto.getMessageTracker();
            dto.setMessageTracker(workerID + TCP_DELIMITER + id);
        } else {
            dto.setMessageTracker(workerID + TCP_DELIMITER);
        }
    }

    /**
     * Send response back to user after response has been added by the client agent.
     *
     * @param dto - processed object.
     * @throws IOException
     */
    private void processSendResponse(DataTransferObject dto) throws IOException {

        String workerID = checkTCP(dto);
        if (workerID == null) {
            //this is a rabbit mq request
            //TODO: MAKE SURE ALL AICORE OBJECTS HAVE CLONE METHODS!!!!!
            sendResponse(dto.clone());
        } else {
            //this is a tcp request
            String json = JsonObjectParser.asJSON(dto);
            jTCPServer.sendObject(workerID, json);
        }
        checkDeleteClientAgent(dto);
    }

    /**
     * Check if this request came in via TCP.
     *
     * @param dto - request processed.
     * @return - worker id if this was a tcp request, null otherwise.
     */
    private String checkTCP(DataTransferObject dto) {
        String id = dto.getMessageTracker();
        if (id == null) {
            //no worker id
            return null;
        }
        int index = id.indexOf(TCP_DELIMITER);
        if (index == -1) {
            //This would not be TCP - no worker id
            return null;
        }

        String workerID = id.substring(0, index);
        try {
            String remaining = id.substring(index + TCP_DELIMITER.length());
            if (!remaining.isBlank()) {
                dto.setMessageTracker(remaining);
            }
        } catch (IndexOutOfBoundsException e) {
            //do nothing
        }

        return workerID;
    }

    /**
     * Need to end client agent instance if this was an unregistered request.
     *
     * @param dto - object that is/was processing.
     */
    private void checkDeleteClientAgent(DataTransferObject dto) {
        if (dto.getMessage() instanceof UserRequest ur) {
            if (ur.getClientID() == null && ur.isComplete()) {
                //if we are here, this was a temp user and the request has been completed, delete agent instance
                jClientAgentHandler.shutDownTempClientAgent(ur.getMessageTracker());
            }
        } else if (dto.getMessage() instanceof GetCommandsRequest gcr) {
            if (gcr.getClientID() == null) {
                //if we are here, this was a temp user and the request has been completed, delete agent instance
                jClientAgentHandler.shutDownTempClientAgent(gcr.getMessageTracker());
            }
        }

    }

    @Override
