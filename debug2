    }

    @Override
    public void processDataTransferObject(DataTransferObject dto) {
        BTO bto = dto.getMessage();
        try {
//            if (!licenseIsValid()) {
//                // send InvalidLicense Message
//                if (bto instanceof TerminateServiceMessage) {
//                    terminateCommunication((TerminateServiceMessage) bto);
//                } else {
//                    sendInvalidLicenseMessage(dto.getHeader());
//                }
//                return;
//            }

            if (bto instanceof TerminateServiceMessage) {
                terminateCommunication(getIdentificationId());
            } else if (bto instanceof DatabaseBackupMessage) {
                processDBBackupRequest((DatabaseBackupMessage) bto);
                onResponse(dto);
            } else if (bto instanceof GetLicenseInfo) {
                processGetLicenseInfo((GetLicenseInfo) bto);
                onResponse(dto);
            } else if (bto instanceof RegistrationRequest rr) {
                jClientBoardMetrics.requestIn();
                processRegistration(rr);
                onResponse(dto);
            } else if (bto instanceof EndRegistrationRequest err) {
                jClientBoardMetrics.requestIn();
                processEndRegistration(err);
                jL.info("Deregistering: {}", err.getClientID());
                onResponse(dto);
            } else if (bto instanceof GetCommandsRequest) {
                jClientBoardMetrics.requestIn();
                sendRequestToClientAgent(dto);
            } else if (bto instanceof UserRequest) {
                jClientBoardMetrics.requestIn();
                sendRequestToClientAgent(dto);
            } else {
                jL.debug("Unknown data received. It was not processed. {}", dto.getMessage().toString());
            }
        } catch (Throwable th) {
            ErrorMessage errorMessage = new ErrorMessage(bto);
            errorMessage.addErrorReason(th.getMessage());
            dto.setMessage(errorMessage);
            onResponse(dto);
            jL.debug("Error Encountered. ", th);

        }
    }

    private void processEndRegistration(EndRegistrationRequest err) {
        jClientAgentHandler.deregisterClient(err);
    }

    /***
     * Process user request.
     * @param dto - object sent by user.
     */
    private void sendRequestToClientAgent(DataTransferObject dto) {

        UUID clientID = null;
        if (dto.getMessage() instanceof UserRequest ur) {
            clientID = ur.getClientID();
        } else if (dto.getMessage() instanceof GetCommandsRequest gcr) {
            clientID = gcr.getClientID();
        }


        ClientAgent ca;

        //if there is a client id, user is registered - grab client agent
        if (clientID != null) {
            ca = jClientAgentHandler.getClientAgent(clientID);

        } else {
            //else instantiate a new one
            ca = jClientAgentHandler.createTempClientAgent(dto.getMessage());
        }
        if (ca != null) {
            ca.addTask(dto);
        } else {
            jL.error("Client agent could not be retrieved/created - user request could not be processed!");
            jClientBoardMetrics.requestFailed();
        }

    }

    /**
     * Process user registration request.
     *
     * @param registrationRequest
     */
    private void processRegistration(RegistrationRequest registrationRequest) {
        jClientAgentHandler.registerClient(registrationRequest);
    }

    /***
     * Method used to queue DTO's that have been processed by client agent.
     * @param response - dto object that has been updated with response(s) by a client agent.
     */
    @Override
    public void onResponse(DataTransferObject response) {
        try {
            jResponseQueue.put(response);
        } catch (InterruptedException e) {
            jL.error("Error queueing response - cannot send response: {}", e.getMessage());
        }

    }

    /**
     * Called by the client agent when there has been an error in completing a user request.
     *
     * @param error
     */
    @Override
    public void onError(Throwable error) {
        jL.error("Error processing user request: {}", error.getMessage());
    }

    /**
     * Shutdown the TCP receiver, scanner and response executors.
     */
    public void shutdownExecutors() {
        jServiceRunning.getAndSet(false);
        jClientAgentHandler.shutdownScannerExecutor();
    }

    /**
     * Received json object via TCP - parse and add to receive queue for processing.
     *
     * @param workerId   - id of the worker thread that received the object.
     * @param jsonString - json object
     */
    @Override
    public void receivedObject(String workerId, String jsonString) {

        DataTransferObject dto;
        try {
            dto = JsonObjectParser.asObject(jsonString, DataTransferObject.class);
            if (dto != null) {
                addTCPTag(dto, workerId);
                jTCPReceiverQueue.put(dto);
            }

        } catch (JsonProcessingException e) {
            jL.error("Could not parse JSON into DataTransferObject: {}", e.getMessage());
        } catch (InterruptedException e) {
            jL.error("Could not add JSON object to TCP Queue: {}", e.getMessage());
        }


    }

    /***
     * Process object received via TCP.
     */
    private void processTCPObjectQueue() {
        while (jServiceRunning.get()) {
            try {
                //block until something arrives
                DataTransferObject dto = jTCPReceiverQueue.poll(500, TimeUnit.MILLISECONDS);
                if (dto != null) {
                    processDataTransferObject(dto);
                }

            } catch (InterruptedException e) {
                Thread.currentThread().interrupt();
            }
        }
    }

    /***
     * Notification that socket has been closed.
     * @param workerId - id of the worker thread that has shutdown the stream.
     */
    @Override
    public void streamShutdownNotif(String workerId) {
        jL.info("Stream closed.");
    }

    /***
     * New client connection made - add this as a data listener.
     * @param id - worker id of the worker thread that has been made for the client connecting.
     */
    @Override
    public void receivedClientConnection(String id) {
        jTCPServer.addDataListener(id, this);
    }

    @Override
    public void serverStatusNotify(String status) {
        jL.info(status);
    }

    @Override
    public void terminateCommunication(String tsm) {
        jL.debug("Shutting down JSON TCP Server...");
        jTCPServer.stop();
        jL.debug("TCP server stopped.");
        jL.debug("Shutting down executors...");
        shutdownExecutors();
        jL.debug("Executors have been shut down.");
        super.terminateCommunication(tsm);
    }
}
