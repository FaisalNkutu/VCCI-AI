    private AtomicBoolean jServiceRunning = new AtomicBoolean(true);
    private final ExecutorService jTCPExecutor = Executors.newSingleThreadExecutor();
    private final ExecutorService jResponseExecutor = Executors.newSingleThreadExecutor();
