    public AgentBoard jAgentBoardMetrics;

    @Inject
    public ClientBoard jClientBoardMetrics;

    AgentCard jAgentCard;

    public AiCoreService() {
        jL.info("AiCoreService is up and running");
    }
    //Standalone UI Changes
    public Map<String, String> getConfiguredAgentRegistry() {
    if (jClientAgentHandler == null) {
        return Collections.emptyMap();
    }

    return jClientAgentHandler.getAllConfiguredAgents();
}
