    @Override
    public void receivedObject(String workerId, String jsonString) {

        DataTransferObject dto;
        try {
            dto = JsonObjectParser.asObject(jsonString, DataTransferObject.class);
            if (dto != null) {
                addTCPTag(dto, workerId);
                jTCPReceiverQueue.put(dto);
