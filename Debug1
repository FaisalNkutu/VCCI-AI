    public boolean isConnectionNameUnique(String name, DConnection ignore) {
        LinkedList<DConnection> conns = getConnections();
        for (DConnection dc : conns) {
            if (ignore != null && ignore.getConnectionId() == dc.getConnectionId()) {
                continue;
            }
            if (name.trim().equals(dc.getConnectionName().trim())) {
                return false;
            }
        }
        return true;
    }

    @Override
    public void uiObjectLabelChanged(
            IVCCIUIControlObject uiObj,
            String label) {

        // We will modify our data once the notification comes back from
        // the server
        if (label == null) {
            return;
        }

        if (uiObj.isDataFlow()) {
            DDataFlowSpecification dfs = uiObj.getDataFlow();
            if (!isDFSNameUnique(label, dfs)) {
                VCCIDashBoard.setError("Dataflow name is not unique!");
                return;
            }
            if (!isValidUIName(label)) {
                VCCIDashBoard.setError("Dataflow name is not valid!");
                return;
            }

            DDataFlowSpecification dfs_clone = dfs.clone();
            dfs_clone.setDataFlowSpecificationName(label);

            CreateUpdateDataFlowSpecificationRequest cudfsr = new CreateUpdateDataFlowSpecificationRequest(
                    dfs_clone, true);
            cudfsr.setCRUDMarker(BTO.CRUDMarker.UPDATE);

            ParadigmSwingUIDirector.jUIDirector.issueFeatureRequest(this,
                    VCCIDashBoard.getCurrentExercise().getBrokerKey(),
                    VCCIControlPanel.class
                            .getCanonicalName(),
                    MediationService.class
                            .getCanonicalName(),
                    MediationService.CREATE_UPDATE_DATA_FLOW_SPECIFICATION, cudfsr, true);
        } else if (uiObj.isConnection()) {
            DConnection conn = uiObj.getConnection();
            if (!isConnectionNameUnique(label, conn)) {
                VCCIDashBoard.setError("Connection name is not unique!");
                return;
            }
            if (!isValidUIName(label)) {
                VCCIDashBoard.setError("Connection name is not valid!");
                return;
            }
            DConnection conn_clone = conn.clone();
            conn_clone.setConnectionName(label);

            CreateUpdateConnectionRequest cudcr = new CreateUpdateConnectionRequest(
                    conn_clone, true);
            cudcr.setCRUDMarker(BTO.CRUDMarker.UPDATE);

            ParadigmSwingUIDirector.jUIDirector.issueFeatureRequest(this,
                    VCCIDashBoard.getCurrentExercise().getBrokerKey(),
                    VCCIControlPanel.class
                            .getCanonicalName(),
                    MediationService.class
                            .getCanonicalName(),
                    MediationService.CREATE_UPDATE_CONNECTION, cudcr, true);
