    protected IVCCIUIControlObject addConnectionNode(
            DFolder parentFolder,
            IVCCIUIControlObject parentUIObj,
            DConnection conn) {
        if (conn == null) {
            VCCIDashBoard.setError("Connection is null : cannot add connection node ...");
            return null;
        }

        // Make sure we do not already have this one
        IVCCIUIControlObject check
                = jVCCITreeDisplayPanel.getConnectionControlObject(conn.getConnectionId());
        if (check != null) {
            return null;
        }

        // Add connection buttons
        IVCCIUIControlObject uiObj = jVCCITreeDisplayPanel.addConnection(parentFolder, conn, getConnectionIcon(conn));
        if (uiObj != null) {
            final String prefix = conn.getConnectionName();

            //uiObj.addButton(BaseConstants.UI_DIAGNOSTICS, CommonIcons.jDiagnostics16x16Icon, "Diagnostics", "Diagnostics");
            uiObj.addButton(BaseConstants.UI_CONFIGURE, CommonIcons.jSettings16x16Icon, "Configure", "Configure", prefix);
            uiObj.addButton(BaseConstants.UI_CONNECT, CommonIcons.jPlug16x16Icon, "Connect", "Connect", prefix);

            // Set up connection manager
            initializeConnectionManager(uiObj, conn);

            // Here is the case where we have incomplete connections - need to update
            // them here as there will be no status from the server until the connections
            // are actually created and running
            if (!conn.isComplete()) {
                uiObj.markIncomplete(true);
            }
        }

        // Set up a connection manager if there is not already
        // one for this type of connection
        ConnectionTypeManager ctMgr = null;
        DConnectionType connType = getConnectionType(conn);
        if (connType == null) {
            VCCIDashBoard.setError("Connection not available. " +  conn.getConnectionName());
            return null;
        }
        String cType = connType.getConnectionTypeName();
        long connTypeId = conn.getConnectionTypeId();

        if (!jConnTypeManagersHash.containsKey(connTypeId)) {
            if (jConnectionTypeManagerLookupHash.containsKey(cType)) {
                String handlerClass = jConnectionTypeManagerLookupHash.get(cType);
                try {
                    Class<?> c = Class.forName(handlerClass, false, Thread.currentThread().getContextClassLoader());
                    Constructor<?> ctor = c.getConstructor(
                            String.class,
                            DConnectionType.class,
                            IVCCIUIControlObject.class
                    );
                    ctMgr = (ConnectionTypeManager) ctor.newInstance(cType + " Connection Type Manager", connType, uiObj);
                    jConnTypeManagersHash.put(connTypeId, ctMgr);

                } catch (ClassNotFoundException | NoSuchMethodException | SecurityException | InstantiationException
                         | IllegalAccessException | IllegalArgumentException | InvocationTargetException ex) {
                    jL.error(ex.getMessage(), ex);
                    VCCIDashBoard.setError(ex.getMessage());
                }
            }
        }
        return uiObj;
    }

    public ConnectionManager getConnectionManager(DConnection conn) {
        if (conn == null) {
            return null;
        }
        ConnectionManager connMgr;
        Long key = conn.getConnectionId();
        if (jConnectionManagersHash.containsKey(key)) {
            connMgr = jConnectionManagersHash.get(key);
            return connMgr;
