    // --- IUINotificationEnabled
    @Override
    public void processNotification(BTO obj) {
        if (obj instanceof FolderNotification) {
            FolderNotification folderNotification = (FolderNotification) obj;
            processFolderNotification(folderNotification);
        } else if (obj instanceof DataFlowSpecificationNotification) {
            DataFlowSpecificationNotification dfsNotification = (DataFlowSpecificationNotification) obj;
            processDFSNotification(dfsNotification);

            if (jCurrentDFSConfigurationPanel != null) {
                jCurrentDFSConfigurationPanel.dataflowUpdatedNotify(dfsNotification.getDataFlowSpecification());
            }

            // And let the manager handle the notification as well
            DataFlowManager mgr = getDataflowManager(dfsNotification.getDataFlowSpecification());
            if (mgr != null) {
                mgr.processNotification(obj);
            }
        } else if (obj instanceof ConnectionNotification) {
            ConnectionNotification connNotification = (ConnectionNotification) obj;
            processConnectionNotification(connNotification);

            // And let the manager handle the notification as well
            ConnectionManager mgr = getConnectionManager(connNotification.getConnection());
            if (mgr != null) {
                mgr.processNotification(obj);
            }

            if (connNotification.isDelete()) {
                if (jCapabilityImplementationPanel != null) {
                    jCapabilityImplementationPanel.connectionDeleteNotification(connNotification.getConnection());
                }
            } else if (connNotification.isUpdate()) {
                if (jCapabilityImplementationPanel != null) {
                    //jCapabilityImplementationPanel.connectionUpdateNotification(connNotification.getConnection());
                }
            }
        } else if (obj instanceof ConnectionTypeNotification) {
            ConnectionTypeNotification ctn = (ConnectionTypeNotification) obj;
            processConnectionTypeNotification(ctn);
        } else if (obj instanceof MediationStatusesNotification) {
            MediationStatusesNotification msn = (MediationStatusesNotification) obj;
            processMediationStatusesNotification(msn);
        } else if (obj instanceof DisplayableContent) {
            if (jCurrentDiagnosticsPanel != null) {
                if (jCurrentDiagnosticsPanel instanceof DataFlowSpecificationDiagnosticsBase) {
                    // Make sure that this diagnostic is for the dataflow for
                    // which we are showing the diagnostics panel
                    DataFlowSpecificationDiagnosticsBase base = (DataFlowSpecificationDiagnosticsBase) jCurrentDiagnosticsPanel;
                    DDataFlowSpecification dfs = base.getDFS();
                    if (dfs != null) {
                        DisplayableContent dcont = (DisplayableContent) obj;
                        ModelObject mo = dcont.getContent();
                        if (mo instanceof DataFlowDiagnostics) {
                            DataFlowDiagnostics dfd = (DataFlowDiagnostics) mo;
                            if (dfd.getIdAsLong() == dfs.getDataFlowSpecificationIndex()) {
                                jCurrentDiagnosticsPanel.updateDiagnostics((DisplayableContent) obj);
                            }
                        }
                    }
                } else if (jCurrentDiagnosticsPanel instanceof FolderDiagnosticsBase) {
                    // Make sure that this diagnostic is for the dataflow for
                    // which we are showing the diagnostics panel
                    FolderDiagnosticsBase base = (FolderDiagnosticsBase) jCurrentDiagnosticsPanel;
                    DFolder df = base.getFolder();
                    if (df != null) {
                        DisplayableContent dcont = (DisplayableContent) obj;
                        ModelObject mo = dcont.getContent();
                        if (mo instanceof FolderDiagnostics) {
                            FolderDiagnostics fd = (FolderDiagnostics) mo;
                            if (fd.getIdAsLong() == df.getFolderId()) {
                                jCurrentDiagnosticsPanel.updateDiagnostics((DisplayableContent) obj);
                            }
                        }
                    }
                }
            }
        } else if (obj instanceof MapperChangeNotification) {
            processMappingNotification((MapperChangeNotification) obj);
        }
    }

    private void processMappingNotification(MapperChangeNotification notification) {

        IVCCIUIControlObject uiObj
                = jVCCITreeDisplayPanel.getDataFlowControlObject(notification.getDataFlowSpecificationId());
        DDataFlowSpecification dfs = null;

        if (uiObj != null) {
            dfs = uiObj.getDataFlow();

            String mapperUse = notification.getMapperUse();
            DMapper mapper = dfs.getMapper(mapperUse);
            if (mapper != null) {
                LinkedList<DMapping> mappings = notification.getMappings();
                for (DMapping mapping : mappings) {
                    if (notification.getCRUDMarker() == MapperChangeNotification.CRUDMarker.DELETE) {
                        mapper.removeMappingBySrcId(mapping.getSrcObject().getMappedObjectObjectId());
                    } else if (notification.getCRUDMarker() == MapperChangeNotification.CRUDMarker.CREATE) {
                        mapper.addMapping(mapping, false);
                    } else if (notification.getCRUDMarker() == MapperChangeNotification.CRUDMarker.UPDATE) {
                        mapper.removeMappingBySrcId(mapping.getSrcObject().getMappedObjectObjectId());
                        mapper.addMapping(mapping, false);
                    }
                }
            }
        }
    }

