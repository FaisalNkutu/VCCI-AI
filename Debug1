                if (jCurrentDFSConfigurationPanel.getDFS().getDataFlowSpecificationIndex() == dfs.getDataFlowSpecificationIndex()) {
                    jCurrentDFSConfigurationPanel.connectionUpdatedNotify(conn);
                }
            }
        }
    }

    private void updateConnectionStatus(
            Long id,
            DisplayableStatus ds) {

        if (ds == null) {
            return;
        }

        IVCCIUIControlObject uiObj = jVCCITreeDisplayPanel.getConnectionControlObject(id);

        if (uiObj == null) {
            return;
        }
        // Store latest status with connection
        uiObj.setAppUserObject(DISPLAYABLE_STATUS_OBJECT, ds);

        DConnection dconn = uiObj.getConnection();

        if (!dconn.isComplete()) {
            uiObj.markIncomplete(true);

        } else {
            // Update status
            NodeMarking marking = VCCIDashBoard.getMarking(ds);
            uiObj.setMarking(marking);

            String label = ds.getLabel().trim();
            if (label.equals("")) {
                label = " ";
            }

            uiObj.setMessage(ds.getLabel());

            if (ds.getProgress() >= 0.0f) {

                int progress = (int) ds.getProgress();
                int max = ds.getCount();
                if (max > 0) {
                    progress = (int) Math.round((ds.getProgress() / 100.0f) * (float) max);
                }
                uiObj.setProgress(progress, max);
                TreeProgressBar.ProgressBarStatus progressStatus = TreeProgressBar.ProgressBarStatus.NORMAL;
                switch (ds.getProgressColor()) {
                    case YELLOW: {
                        progressStatus = TreeProgressBar.ProgressBarStatus.YELLOW;
                        break;
                    }
                    case RED: {
                        progressStatus = TreeProgressBar.ProgressBarStatus.RED;
                        break;
                    }
                }
                uiObj.setProgressStatus(progressStatus);
            } else {
                uiObj.removeProgressBar();
            }
        }

        // Now deal with the settings of the icon buttons
        LinkedHashMap<String, Boolean> settings = ds.getUIControlSettings();
        Iterator<String> kIter = settings.keySet().iterator();
        String key;
        while (kIter.hasNext()) {
            key = kIter.next();
            uiObj.setButtonEnabled(key, settings.get(key));
        }
    }

    public void updateDataflowStatus(
            Long id,
            DisplayableStatus ds) {
        IVCCIUIControlObject uiObj = jVCCITreeDisplayPanel.getDataFlowControlObject(id);

        if (uiObj != null) {
            // Store latest status with dataflow
            uiObj.setAppUserObject(DISPLAYABLE_STATUS_OBJECT, ds);

            DDataFlowSpecification dfs = uiObj.getDataFlow();
            if (dfs == null) {
                return;
            }
            if (!dfs.isComplete()) {
                uiObj.markIncomplete(true);
            } else {
                // Update status
                NodeMarking marking = VCCIDashBoard.getMarking(ds);
                uiObj.setMarking(marking);

                // Set message
                uiObj.setMessage(ds.getCountdownLabel() + ds.getLabel());

                if (ds.getProgress() >= 0.0f) {
                    int progress = (int) ds.getProgress();
                    int max = ds.getCount();
                    if (max > 0) {
                        progress = (int) Math.round((ds.getProgress() / 100.0f) * (float) max);
                    }
                    uiObj.setProgress(progress, max);
                    // System.err.println("DFSPANEL: progress=" + progress + " max=" + max);
                    TreeProgressBar.ProgressBarStatus progressStatus = TreeProgressBar.ProgressBarStatus.NORMAL;
                    switch (ds.getProgressColor()) {
                        case YELLOW: {
                            progressStatus = TreeProgressBar.ProgressBarStatus.YELLOW;
                            break;
                        }
                        case RED: {
                            progressStatus = TreeProgressBar.ProgressBarStatus.RED;
                            break;
                        }
                    }
                    uiObj.setProgressStatus(progressStatus);
                } else {
                    uiObj.removeProgressBar();
                    if (ds.getCount() != -1) {
                        if (ds.getCountLabel().trim().isEmpty()) {
                            uiObj.setMessage(ds.getCountdownLabel() + ds.getLabel() + String.format("Items Queued: %s", "" + ds.getCount()));
                        } else {
                            uiObj.setMessage(ds.getCountdownLabel() + ds.getLabel() + " " + ds.getCountLabel() + ds.getCount());
                        }
                    }
                }
            }

            // Now deal with the settings of the icon buttons
            LinkedHashMap<String, Boolean> settings = ds.getUIControlSettings();
            Iterator<String> kIter = settings.keySet().iterator();
            String key;
            while (kIter.hasNext()) {
                key = kIter.next();
                uiObj.setButtonEnabled(key, settings.get(key));
            }

            // And update containing folder status (get folder via the connection)
            DConnection dc = dfs.getConnection();
            long folderId = dc.getConnectionFolderId();
            IVCCIUIControlObject fObj = jVCCITreeDisplayPanel.getFolderControlObject(folderId);
            if (fObj != null) {
                updateFolderStatus(fObj);
            }
        }
    }

    private void updateFolderStatus(IVCCIUIControlObject uiObj) {

        if (uiObj != null) {
            // Get all contained dataflows
            LinkedList<IVCCIUIControlObject> dataflows
                    = jVCCITreeDisplayPanel.getDataFlowsRecursively(uiObj);

            // MAGI: TODO - ADD CONNECTIONS AS WELL??
            // Get worst status from all dataflows
            NodeMarking current = NodeMarking.NORMAL;
            NodeMarking marking;

            DisplayableStatus ds;
            DDataFlowSpecification dfs;
            Object obj;
            boolean isIncomplete = false;
            for (IVCCIUIControlObject dfObj : dataflows) {
                dfs = dfObj.getDataFlow();
                if (dfs == null) {
                    continue;
                }
                if (!dfs.isComplete()) {
                    isIncomplete = true;
                    break;
                } else {
                    obj = dfObj.getAppUserObject(DISPLAYABLE_STATUS_OBJECT);
                    if (obj instanceof DisplayableStatus) {
                        ds = (DisplayableStatus) obj;
                        marking = VCCIDashBoard.getMarking(ds);
                        if (isFirstWorseThanSecond(marking, current)) {
                            current = marking;
                        }
                    }
                }
            }

            if (isIncomplete) {
                uiObj.markIncomplete(true);
            } else {
                uiObj.setMarking(current);
                uiObj.enableAllButtons(true);
            }

            // Filter upwards
