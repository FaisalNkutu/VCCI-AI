    public void checkAndSaveDataflows(DConnection conn) {
        LinkedList<DDataFlowSpecification> dataflows = getDataflowsUsingConnection(conn);

        DFSContentSubPanelBase dfsPanel = null;
        long dfsConnId;
        for (DDataFlowSpecification dfs : dataflows) {
            dfsConnId = dfs.getDataFlowSpecificationConnectionId();
            if (!dfs.isComplete() && (conn.getConnectionId() == dfsConnId)) {
                // Use the DFS configuration panel to check if critical parameters exist
                dfsPanel = AddDFSPanel.generateDerivedForm(
                        null,
                        dfs.getSystemCapability(),
                        dfs.getConnection(),
                        getConnectionType(conn),
                        dfs);

                if (dfsPanel != null) {
                    if (!dfsPanel.hasCriticalParameters()) {
                        // Go ahead and save the data flow
                        DDataFlowSpecification dfs_clone = dfs.clone();
                        dfs_clone.setIsComplete(true);
                        DConnectionType checkConnType = VCCIDashBoard.ref().getConnectionTypeByConnectionTypeId(conn.getConnectionTypeId());
                        if (checkConnType != null && checkConnType.getConnectionTypeName().equals(Constants.CT_TSI)) {
                            dfs_clone.setDataFlowSpecificationName(conn.getConnectionName());
                        }

                        CreateUpdateDataFlowSpecificationRequest cudfsr = new CreateUpdateDataFlowSpecificationRequest(
                                dfs_clone, true);
                        cudfsr.setCRUDMarker(BTO.CRUDMarker.UPDATE);

                        ParadigmSwingUIDirector.jUIDirector.issueFeatureRequest(this,
                                VCCIDashBoard.getCurrentExercise().getBrokerKey(),
                                VCCIControlPanel.class
                                        .getCanonicalName(),
                                MediationService.class
                                        .getCanonicalName(),
                                MediationService.CREATE_UPDATE_DATA_FLOW_SPECIFICATION, cudfsr, true);
                    }
                }
            }
        }
    }

    public void processDFSNotification(DataFlowSpecificationNotification notification) {
        if (jHiddenFolder == null || jInternalFolder == null) {
            // Added for Automated testing - timing issue
            return;
        }
        // More robust check
        if (!VCCIDashBoard.jVCCIDashBoard.isSystemReady()) {
            return;
        }

        DDataFlowSpecification dfs = notification.getDataFlowSpecification();
        if (dfs == null) {
            return;
        }

        if (!setSpecialDataflowVariables(dfs)) {
            DConnection dc = dfs.getConnection();
            IVCCIUIControlObject dfUIObj = jVCCITreeDisplayPanel.getDataFlowControlObject(dfs.getDataFlowSpecificationIndex());
            IVCCIUIControlObject connUIObj = null;
            if (dc != null) {
                connUIObj = jVCCITreeDisplayPanel.getConnectionControlObject(dc.getConnectionId());
            }

            if (notification.isUpdate()) {
                // Update Case
                if (dfUIObj == null) {
                    VCCIDashBoard.setError("Internal Error: Could not find Dataflow with id = " + dfs.getDataFlowSpecificationIndex());
                    return;
                }

                // Set new object in our model
                jVCCITreeDisplayPanel.updateDataFlow(dfs);
                dfUIObj.setControlObjectName(dfs.getDataFlowSpecificationName());

                // And we might not yet have initialized the manager - note that this method
                // can be called many times
                DataFlowManager dfm = getDataflowManager(dfs);
                if (dfm != null) {
                    dfm.initialize(dfs.isComplete());

                    // Also check to see there is a diagnostics panel with the manager - reset it if there is
                    // since the data flow has been updated
                    dfm.setDiagnosticsPanel(null);
                }
            } else if (notification.isCreate()) {
                // See if it is one of our special dataflows
                if (connUIObj != null) {
                    addDataFlowNode(connUIObj, dfs);
                }
                markAllowedCapabilities();
            } else if (notification.isDelete()) {
                if (dfUIObj == null) {
                    VCCIDashBoard.setError("Internal Error: Could not find Dataflow with id = " + dfs.getDataFlowSpecificationIndex());
                    return;
                }

                // Remove the data flow manager
                DataFlowManager dfm = this.getDataflowManager(dfs);
                if (dfm != null) {
                    // Is this form in view
                    if (jCurrentDFSManager == dfm) {
                        VCCIDashBoard.ref().resetAllRightSidePanels();
                        jCurrentDFSManager = null;
                    }

                    Long key = dfs.getDataFlowSpecificationIndex();
                    jDFSManagersHash.remove(key);

                    // And clean up all subscriptions
                    dfm.removeObjectManagerSubscriptions();
                    ParadigmSwingUIDirector.jUIDirector.removeObjectNotificationSubscriptions(dfm);
                }

                // Diagnostics panel open for this data flow?
                if (jCurrentDiagnosticsPanel instanceof DataFlowSpecificationDiagnosticsBase) {
                    DataFlowSpecificationDiagnosticsBase dp = (DataFlowSpecificationDiagnosticsBase) jCurrentDiagnosticsPanel;
                    DDataFlowSpecification checkDFS = dp.getDFS();
                    if (checkDFS != null && checkDFS.getDataFlowSpecificationIndex() == dfs.getDataFlowSpecificationIndex()) {
                        VCCIDashBoard.ref().resetAllRightSidePanels();
                    }
                }

                // Configuration panel for this data flow?
                if (jCurrentDFSConfigurationPanel instanceof AddDFSPanel) {
                    AddDFSPanel dp = (AddDFSPanel) jCurrentDFSConfigurationPanel;
                    DDataFlowSpecification checkDFS = dp.getDFS();
                    if (checkDFS != null && checkDFS.getDataFlowSpecificationIndex() == dfs.getDataFlowSpecificationIndex()) {
                        VCCIDashBoard.ref().resetAllRightSidePanels();
                    }
                }

                // Remove node from the tree
                jVCCITreeDisplayPanel.deleteDataFlow(dfs);

                if (jCurrentDataFlow == dfs) {
                    jCurrentDataFlow = null;
                }
                markAllowedCapabilities();
            }
            VCCIDashBoard.ref().updateSystemDiagram();
        }
    }

    private void processConnectionNotification(ConnectionNotification notification) {
        // Protect state
        if (!VCCIDashBoard.jVCCIDashBoard.isSystemReady()) {
            return;
        }
        // See if we can find this same connection in the tree - if we find it
        // this is an update notification - else we need to add it
        if (notification == null) {
            return;
        }
        DConnection conn = notification.getConnection();
        if (conn == null) {
            return;
        }
        long folderId = conn.getConnectionFolderId();

        IVCCIUIControlObject folderUIObj
                = jVCCITreeDisplayPanel.getFolderControlObject(folderId);
        IVCCIUIControlObject connUIObj
                = jVCCITreeDisplayPanel.getConnectionControlObject(conn.getConnectionId());

        // Note that the folder here might be null - in the case when a connection
        // is being dragged out of a folder and back to the root (or if it was
        // not set on create)
        DFolder folder = findDFolder(folderId);

        if (notification.isUpdate()) {
            if (connUIObj != null) {
                // Update Case
                connUIObj.setControlObjectName(conn.getConnectionName());

                // And we may not yet have called initialize
                ConnectionManager cm = this.getConnectionManager(conn);
                if (cm != null) {
                    cm.initialize(conn.isComplete());
                }

                // And make sure all dataflows that use this connection get the
                // new copy
                connectionUpdatedNotify(conn);

                // And make sure we save any incomplete data flows that are waiting
                // for this connection to be complete
                checkAndSaveDataflows(conn);

                // Make sure we update this connection in the connection type
                long cTypeId = conn.getConnectionTypeId();
                DConnectionType dct = getConnectionTypeByConnectionTypeId(cTypeId);
                if (dct != null) {
                    dct.updateConnection(conn);
                }

                jVCCITreeDisplayPanel.updateConnection(conn);

                // And if we have a diagnostics panel already set up for this
                // panel - remove it. It will get reintiailzed the next time
                // someone asks for the diagnostics panel
                Long connKey = conn.getConnectionId();
                if (jConnToDiagnosticsPanelHash.containsKey(connKey)) {
                    jConnToDiagnosticsPanelHash.remove(connKey);
                }
            }
        } else if (notification.isCreate()) {
            // New Connection Case
            if (folder != null) {
                addConnectionNode(folder, folderUIObj, conn);
            } else {
                System.err.println("SHOULD NOT HAPPEN - FOLDER IS NULL FOR NEW CONNECTION!!!!");
            }
            DConnectionType ct = getConnectionTypeByConnectionTypeId(conn.getConnectionTypeId());
            if (ct != null) {
                // Make sure we add this connection to the connection type
                long cTypeId = conn.getConnectionTypeId();
                DConnectionType dct = getConnectionTypeByConnectionTypeId(cTypeId);
                if (dct != null) {
                    dct.addConnection(conn);
                }
            }
        } else if (notification.isDelete()) {
            // Might be null if multiple folders have been deleted and we
            // notifications out of order so handle that case
            if (connUIObj != null) {
                //deleteConnectionNode(search);
                // Diagnostics panel open for this connection?
                if (jCurrentDiagnosticsPanel != null) {
                    if (jCurrentDiagnosticsPanel instanceof ConnectionDiagnosticsBase) {
                        ConnectionDiagnosticsBase dp = (ConnectionDiagnosticsBase) jCurrentDiagnosticsPanel;
                        DConnection checkConn = dp.getConnection();
                        if (checkConn != null && checkConn.getConnectionId() == conn.getConnectionId()) {
                            VCCIDashBoard.ref().resetAllRightSidePanels();
                        }
                    }
                }
                // Configuration panel for this data flow?
                if (jCurrentConnectionConfigurationPanel != null) {
                    if (jCurrentConnectionConfigurationPanel instanceof ConnectionConfigurationPanelBase) {
                        ConnectionConfigurationPanelBase cp = (ConnectionConfigurationPanelBase) jCurrentConnectionConfigurationPanel;
                        DConnection checkConn = cp.getConnection();
                        if (checkConn != null && checkConn.getConnectionId() == conn.getConnectionId()) {
                            VCCIDashBoard.ref().resetAllRightSidePanels();
                        }
                    }
                }

                // Make sure we remove this connection from the connection type
                long cTypeId = conn.getConnectionTypeId();
                DConnectionType dct = getConnectionTypeByConnectionTypeId(cTypeId);
                if (dct != null) {
                    dct.removeConnection(conn.getConnectionId());
                }

                // Remove the connection manager
                ConnectionManager cm = getConnectionManager(conn);
                if (cm != null) {
                    Long key = conn.getConnectionId();
                    jConnectionManagersHash.remove(key);

                    // And clean up all subscriptions
                    ParadigmSwingUIDirector.jUIDirector.removeObjectNotificationSubscriptions(cm);
                }
                jVCCITreeDisplayPanel.deleteConnection(conn);
                if (jCurrentConnection == conn) {
                    jCurrentConnection = null;
                }
            }
        }
        VCCIDashBoard.ref().updateSystemDiagram();
    }

