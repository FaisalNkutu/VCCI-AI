            if (!isValidUIName(label)) {
                VCCIDashBoard.setError("Folder name is not valid!");
                return;
            }
            DFolder df_clone = df.clone();
            df_clone.setFolderName(label);
            CreateUpdateFolderRequest cufr = new CreateUpdateFolderRequest(
                    Request.CRUDMarker.UPDATE,
                    CreateUpdateFolderRequest.UpdateType.UPDATE_ATTRIBUTES,
