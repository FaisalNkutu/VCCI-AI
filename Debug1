    private void deleteConnectionAction(IVCCIUIControlObject uiObj) {

        if (uiObj == null) {
            return;
        }

        DConnection conn = uiObj.getConnection();

        if (conn == null) {
            System.err.println("Internal error! No connection for node!");
            return;
        }

        // Check to make sure that this connection is not used by
        // any dataflows
        LinkedList<DDataFlowSpecification> dfsList = getDataflowsUsingConnection(conn);
