    public void processMediationStatusesNotification(MediationStatusesNotification msn) {
        // Handle dataflow status
        LinkedHashMap<Long, DisplayableStatus> dfStatuses = msn.getDataFlowStatuses();
        Set<Long> keySet = dfStatuses.keySet();
        Iterator<Long> kIter = keySet.iterator();
        Long id;
        while (kIter.hasNext()) {
            id = kIter.next();
            updateDataflowStatus(id, dfStatuses.get(id));
        }

        // Handle connection status
        LinkedHashMap<Long, DisplayableStatus> connStatuses = msn.getConnectionStatuses();
        keySet = connStatuses.keySet();
        kIter = keySet.iterator();
        while (kIter.hasNext()) {
            id = kIter.next();
            updateConnectionStatus(id, connStatuses.get(id));
        }

        // Handle the system view
        if (VCCIDashBoard.ref().getSystemView() != null) {
            VCCIDashBoard.ref().getSystemView().processMediationStatusesNotification(msn);
        }
    }

