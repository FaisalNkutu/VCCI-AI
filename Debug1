    public LinkedList<DConnectionType> getAllConnectionTypes() {
        return jConnectionTypes;
    }

    public DConnectionType getConnectionTypeByID(long id) {
        for (DConnectionType cType : jConnectionTypes) {
            if (cType.getConnectionTypeId() == id) {
                return cType;
            }
        }
        return null;
    }

    public DConnectionType getConnectionTypeByConnectionId(long connectionId) {
        LinkedList<DConnectionType> cTypes = getConnectionTypes();

        for (DConnectionType cType : cTypes) {
            if (cType.connectionInstanceExists(connectionId)) {
                return cType;
            }
        }
        return null;
    }

    public LinkedList<DConnection> getConnectionsByTypeName(String typeName) {
        LinkedList<DConnection> conns = getConnections();
        LinkedList<DConnection> result = new LinkedList<>();
        DConnectionType dct;

        for (DConnection dc : conns) {
            dct = getConnectionTypeByID(dc.getConnectionTypeId());
            if (dct != null) {
                if (typeName.equals(dct.getConnectionTypeName())) {
                    result.add(dc);
                }
            }
        }
        return result;
    }

    public DConnection getConnectionById(long id) {
        IVCCIUIControlObject controlObject = jVCCITreeDisplayPanel.getConnectionControlObject(id);
        return controlObject != null ? controlObject.getConnection() : null;
    }

    public boolean hasConnectionOfType(DConnectionType dct) {
        if (dct == null) {
            return false;
        }
        LinkedList<DConnection> conns = getConnectionsByTypeName(dct.getConnectionTypeName());
        return conns.size() > 0;
    }

    public void deleteConnection(long connectionId) {

        IVCCIUIControlObject uiObj = jVCCITreeDisplayPanel.getConnectionControlObject(connectionId);

        if (uiObj == null) {
            return;
        }
        deleteConnectionAction(uiObj);
    }

    public static void registerDataflowManager(
            String connectionType,
            String capability,
            String capabilityDirection,
            String classname) {
        jDataflowManagerLookupHash.put(connectionType + ":" + capability + ":" + capabilityDirection, classname);
    }

    public DSystemCapability getSystemCapabilityById(long id) {
        for (DSystemCapability capability : jSystemCapabilities) {
            if (capability.getSystemCapabilityId() == id) {
                return capability;
            }
        }
        return null;
    }

    public DSystemCapability getCapability(
            String capability,
            String direction) {
        String function;

        for (DSystemCapability df : jSystemCapabilities) {
            function = df.getSystemCapabilityName();
            if (function.equals(capability)) {
                if (df.getSystemCapabilityCategoryCode().equals(direction)) {
                    return df;
                }
            }
        }
        return null;
    }

    private void clearToolBar() {
        if (VCCIDashBoard.ref() != null) {
            VToolBarControl tbCtrl = VCCIDashBoard.ref().getToolBarControl();
            if (tbCtrl != null) {
                tbCtrl.clearEntries();
            }
        }
    }
