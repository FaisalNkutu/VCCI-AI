    /**
     * Determines which system capabilities are in use based on the connection types present
     * in jConnectionTypes after being pruned for licensing
     */
    private void determineSystemCapabilitiesInUse() {
        // jConnectionTypes at this point will be pruned to only include the adaptors that
        // are in use by the user
        for (DConnectionType cType : jConnectionTypes) {
            for (Map.Entry<Long, DSystemCapability> sysCap : cType.getSupportedSystemCapabilitys().entrySet())
                // only adds unique entries as jSystemCapabilitiesInUse is a hashset
                jSystemCapabilitiesInUse.add(sysCap.getValue().getSystemCapabilityName());
        }
    }

    public void resetFoldersAndDataFlows(
            GetFoldersRequest gfr,
            GetDataFlowSpecificationsRequest gdfr) {

        jVCCITreeDisplayPanel.clear();
        // Get top level folders
        LinkedList<DFolder> topLevelNodes = gfr.getFolders();
        jVCCITreeDisplayPanel.setTopLevelFolders(topLevelNodes);
        // Set dataflows
        LinkedList<DDataFlowSpecification> dfsList = gdfr.getDataFlowSpecifications();

        for (DDataFlowSpecification dfs : dfsList) {
            setSpecialDataflowVariables(dfs);
        }

        // The children of the root will be the top level nodes for our tree
        LinkedList<DDataFlowSpecification> dataflows = gdfr.getDataFlowSpecifications();
        for (DFolder df : topLevelNodes) {
            if (HIDDEN_FOLDER.equals(df.getFolderName())) {
                jHiddenFolder = df;
                jVCCITreeDisplayPanel.setHiddenFolder(jHiddenFolder);
            } else if (INTERNAL_FOLDER.equals(df.getFolderName())) {
                jInternalFolder = df;
            }

            traverseAndCreate(null, df, dataflows);
        }
        tryStartingServers();
        VCCIDashBoard.ref().updateSystemDiagram();
        markAllowedCapabilities();
    }

