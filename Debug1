            startFFIServerDataflow();
        }
    }

    protected void traverseAndCreate(
            IVCCIUIControlObject parent,
            DFolder df,
            LinkedList<DDataFlowSpecification> dataflows) {

        // We do not show this one visually
        // MAGI: TODO - CAN WE GET RID OF THIS FOLDER NOW (Since those
        // internal datafows no longer use it)
        if (DFolder.FOLDER_CATEGORY_CODE_MISC.equals(df.getFolderCategoryCode())) {
            return;
        }

        // Create node for this folder (if not the hidden folder)
        IVCCIUIControlObject current = null;
        if (jHiddenFolder != df) {
            current = addFolderNode(parent, df);
        }

        // Add connections
        LinkedList<DConnection> conns = df.getConnectionsAsList();
        IVCCIUIControlObject connNode;
        if (conns != null) {
            for (DConnection conn : conns) {
                connNode = addConnectionNode(df, current, conn);

                // And add dataflows - get dataflows for this connection
                LinkedList<DDataFlowSpecification> conndataflows = new LinkedList<>();
                for (DDataFlowSpecification checkDF : dataflows) {
                    if (checkDF.getDataFlowSpecificationConnectionId() == conn.getConnectionId()) {
                        conndataflows.add(checkDF);
                    }
                }
                for (DDataFlowSpecification dfs : conndataflows) {
                    if (!setSpecialDataflowVariables(dfs)) {
                        addDataFlowNode(connNode, dfs);
                    }
                }
            }
        }

        // Recurse on children
        LinkedList<DFolder> children = df.getChildren();
        for (DFolder child : children) {
            traverseAndCreate(current, child, dataflows);
        }
    }

    protected void addDataFlowNode(
            IVCCIUIControlObject parentNode,
            DDataFlowSpecification dfs) {
        if (dfs == null) {
            VCCIDashBoard.setError("Dataflow specification is null : cannot add Dataflow node ...");
            return;
        }

        // Make sure we do not already have this one
        IVCCIUIControlObject check = jVCCITreeDisplayPanel.getDataFlowControlObject(dfs.getDataFlowSpecificationIndex());
        if (check != null) {
            return;
        }

        DConnection dc = dfs.getConnection();
        DSystemCapability df = dfs.getSystemCapability();

        if (df == null || dc == null) {
            if (df == null) {
                VCCIDashBoard.setError("Cannot add Dataflow node : DSystemCapability is null");
            }
            if (dc == null) {
                VCCIDashBoard.setError("Cannot add Dataflow node : DConnection is null");
            }
            return;
        }

        ImageIcon icon = getDataflowIcon(df);
        icon = (icon == null) ? VCCIIcons.jDataFlowIcon : icon;
        String direction = df.getSystemCapabilityCategoryCode();
        IVCCIUIControlObject uiObj = jVCCITreeDisplayPanel.addDataFlow(
                dc,
                dfs,
                icon,
                GSystemCapability.SYSTEM_CAPABILITY_CATEGORY_CODE_IN.equals(direction));
        // Set up data flow manager
        initializeDataFlowManager(uiObj, dfs, dc, df);

        // Here is the case where we have incomplete dataflows - need to update
        // them here as there will be no status from the server until the dataflows
        // are actually created and running
        if (!dfs.isComplete()) {
            uiObj.markIncomplete(true);
        }

        DConnectionType dct = getConnectionType(dc);
        if (dct != null) {
            String connName = dct.getConnectionTypeName();
            if (Constants.CT_CORE.equals(connName) || Constants.CT_DDS.equals(connName) || Constants.CT_VMF.equals(connName)) {
                MapDisplayPanel mdp = MapDisplayPanel.jMapDisplayPanel;
                if (mdp instanceof VCCIMapDisplayPanel) {
                    VCCIMapDisplayPanel vmdp = (VCCIMapDisplayPanel) mdp;
                    vmdp.enableVMFFeatures();
                }
            }
        }
    }

