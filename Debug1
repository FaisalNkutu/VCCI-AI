        BTO params = frr.getFeatureParameters();
        if (params instanceof CreateUpdateDataFlowSpecificationRequest) {
            // Check to see if we failed to start the DISRouter or Disaggregation dataflows
            CreateUpdateDataFlowSpecificationRequest request = (CreateUpdateDataFlowSpecificationRequest) params;
            DDataFlowSpecification dfs = request.getDataFlowSpecification();
            checkSpecialDataflows(dfs);
        } else {
            String msgStr = String.format("Feature request : %s did not get successfully executed. State : %s", frr.getComponentFeatureID(), frr.getStateString());
            VCCIDashBoard.setError(msgStr);
        }
    }

    private void checkSpecialDataflows(DDataFlowSpecification dfs) {
        if (dfs != null) {
            String flow = dfs.getDataFlowSpecificationName();
            if (Constants.CA_ROUTER.equals(flow)) {
                VCCIDashBoard.setError("Unable to create DISRouter Dataflow! Some VCCI functions will not be possible.");
            } else if (Constants.CA_DISAGGREGATION.equals(flow)) {
                VCCIDashBoard.setError("Unable to create Disaggregation Dataflow! Some VCCI functions will not be possible.");
            } else if (Constants.CA_GIS.equals(flow)) {
                VCCIDashBoard.setError("Unable to create GIS Dataflow! Some VCCI functions will not be possible.");
            } else if (Constants.CA_OTH_SERVER.equals(flow)) {
                VCCIDashBoard.setError("Unable to create OTH Server Dataflow! Some VCCI functions will not be possible.");
            } else if (Constants.CA_RAP.equals(flow)) {
                VCCIDashBoard.setError("Unable to create RAP Dataflow! Some VCCI functions will not be possible.");
            } else if (Constants.CA_LINK16_SERVER.equals(flow)) {
                VCCIDashBoard.setError("Unable to create Link-16 Server Dataflow! Some VCCI functions will not be possible.");
            } else if (Constants.CA_FFI_SERVER.equals(flow)) {
                VCCIDashBoard.setError("Unable to create FFI Server Dataflow! Some VCCI functions will not be possible.");
            }
        }
    }

    protected void initializeConnectionManager(
            IVCCIUIControlObject uiObj,
            DConnection dc) {

        DConnectionType dct;
        if (dc != null) {
            dct = getConnectionType(dc);
            if (dct == null) {
                jL.warn("initializeConnectionManager- cannot initialize connection manager for {}: connection type is null", dc.getConnectionName());
                return;
            }

            ConnectionManager connMgr;
            DConnectionType ctype = getConnectionTypeByConnectionTypeId(dc.getConnectionTypeId());
            String cType = ctype.getConnectionTypeName();

            if (jConnectionManagerLookupHash.containsKey(cType)) {
                String handlerClass = jConnectionManagerLookupHash.get(cType);
                try {
                    Class<?> c = Class.forName(handlerClass, false, Thread.currentThread().getContextClassLoader());
                    Constructor<?> ctor = c.getConstructor(
                            String.class,
                            DConnection.class,
                            IVCCIUIControlObject.class
                    );
                    connMgr = (ConnectionManager) ctor.newInstance(dc.getConnectionName(), dc, uiObj);
                    jConnectionManagersHash.put(dc.getConnectionId(), connMgr);
                    connMgr.initialize(dc.isComplete());
                } catch (ClassNotFoundException | NoSuchMethodException | SecurityException | InstantiationException
                         | IllegalAccessException | IllegalArgumentException | InvocationTargetException ex) {
                    jL.error(ex.getMessage(), ex);
                    VCCIDashBoard.setError(ex.getMessage());
                }
            }
        }
    }

