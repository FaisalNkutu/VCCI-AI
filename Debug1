    public void capabilityButtonPressed(DSystemCapability systemCapability) {
        if (systemCapability != null) {
            switch (systemCapability.getSystemCapabilityName()) {
                case Constants.CA_ROUTER:
                    if (jDISRouterDiagnosticsPanel == null) {
                        jDISRouterDiagnosticsPanel = new DISRouterDataFlowDiagnostics("DIS Router Diagnostics", jDISRouterDataflow);
                        jDISRouterDiagnosticsPanel.setNetworkAdaptorsRequest(VCCIDashBoard.ref().getNetworkAdaptorsRequest());
                    }
                    showDataflowDiagnostics(null, jDISRouterDataflow);
                    return;
                case Constants.CA_DISAGGREGATION:
                    if (jDisaggregationFilterPanel != null) {
                        ParadigmSwingUIDirector.jUIDirector.removeObjectNotificationSubscriptions(jDisaggregationFilterPanel);
                        jDisaggregationFilterPanel = null;
                    }
                    jDisaggregationFilterPanel = new DisaggregationFilterPanel("Filter Panel", jDisaggregationDataflow);
                    showDataflowDiagnostics(null, jDisaggregationDataflow);
                    return;
                case Constants.CA_MIP:
                case Constants.CA_API_SERVER:
                case Constants.CA_HIVE_SERVER:
                case Constants.CA_NMEA_SERVER:
                case Constants.CA_RAP:
                    showServerDiagnostics(systemCapability);
                    return;
                case Constants.CA_METRICS:
                    if (jMetricsConfigurationPanel == null) {
                        jMetricsConfigurationPanel = new MetricsConfigurationPanel("Metrics Configuration");
                    }
                    // To avoid making a dataflow we just activate the panel here
                    if (jCurrentDiagnosticsPanel != jMetricsConfigurationPanel) {
                        removeCurrentDiagnosticsPanel();
                        VCCIDashBoard.ref().showRightSidePanel(jMetricsConfigurationPanel, null, false);
                        jMetricsConfigurationPanel.panelShownNotification();
                        jCurrentDiagnosticsPanel = jMetricsConfigurationPanel;
                        jCurrentDFSManager = null;
                        jCurrentDFSConfigurationPanel = null;
                    }
                    return;
                case Constants.CA_OTH_SERVER:
                    showDataflowDiagnostics(null, jOthGoldServerDataflow);
                    return;
                case Constants.CA_FFI_SERVER:
                    showDataflowDiagnostics(null, jFFIServerDataflow);
                    return;
                case Constants.CA_LINK16_SERVER:
                    showDataflowDiagnostics(null, jLink16ServerDataflow);
                    return;
                case Constants.CA_EMULATION:
                    if (this.jEmulationSetupPanel == null) {
                        this.jEmulationSetupPanel = new EmulationSetupPanel("Emulation Diagnostics", jEmulationDataflow);
                    }

                    showDataflowDiagnostics(null, jEmulationDataflow);
                    return;
                default:
                    break;
            }
        }
        // Handle other capabilities
        CapabilityImplementationPanel cip = new CapabilityImplementationPanel(systemCapability, jHiddenFolder);
        VCCIDashBoard.ref().showRightSidePanel(cip, true);
        // We do this here because the above call resets this reference
        jCapabilityImplementationPanel = cip;
    }

