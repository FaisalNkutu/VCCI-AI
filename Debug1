    private void showDataflowDiagnostics(IVCCIUIControlObject uiObj, DDataFlowSpecification dfs) {
        if (dfs == null) {
            VCCIDashBoard.setError("No Dataflow available for selection.  Check logs.");
            jL.error("Unable to show diagnostics panel.  No DataFlow.");
            return;
        }
        // Determine the type of form
        DiagnosticsPanelBase diagnosticsPanelBase = null;
        DConnection connection = dfs.getConnection();
        DSystemCapability systemCapability = dfs.getSystemCapability();
        if (systemCapability == null) {
            return;
        }
        DataFlowManager mgr = getDataflowManager(dfs);
        // TODO : We need to refactor this section --SS
        if (mgr == null || connection == null) {
            // Get derived form based on capability
            if (dfs == jDISRouterDataflow) {
                diagnosticsPanelBase = jDISRouterDiagnosticsPanel;
            } else if (dfs == jDisaggregationDataflow) {
                diagnosticsPanelBase = jDisaggregationFilterPanel;
            } else if (dfs == jEmulationDataflow) {
                diagnosticsPanelBase = jEmulationSetupPanel;
            } else if (dfs == jOthGoldServerDataflow
                    || dfs == jLink16ServerDataflow
                    || dfs == jFFIServerDataflow) {
                if (jServerDiagnosticPanelHash.containsKey(systemCapability.getSystemCapabilityName())) {
                    diagnosticsPanelBase = jServerDiagnosticPanelHash.get(systemCapability.getSystemCapabilityName());
                } else {
                    diagnosticsPanelBase = DataFlowSpecificationDiagnosticsBase.generateDataFlowDerivedForm(systemCapability, dfs, String.format("%s Diagnostics", systemCapability.getSystemCapabilityName()));
                    // Cache it
                    if (diagnosticsPanelBase != null) {
                        jServerDiagnosticPanelHash.put(systemCapability.getSystemCapabilityName(), diagnosticsPanelBase);
                    }
                }
            }
        } else {
            // Get derived form using capability, connection, and direction.
            diagnosticsPanelBase = mgr.getDiagnosticsPanel();
            if (diagnosticsPanelBase == null) {
                DConnectionType dct = VCCIDashBoard.ref().getConnectionTypeByConnectionTypeId(connection.getConnectionTypeId());
                diagnosticsPanelBase = DataFlowSpecificationDiagnosticsBase.generateDataFlowDerivedForm(systemCapability, dct, dfs, String.format("%s Diagnostics", systemCapability.getSystemCapabilityName()));
                mgr.setDiagnosticsPanel(diagnosticsPanelBase);
            }
        }
        if (diagnosticsPanelBase == null) {
            VCCIDashBoard.setError("Unable to Display Dataflow Diagnostics Panel for " + systemCapability.getSystemCapabilityName() + ".");
            return;
        }
        if (jCurrentDiagnosticsPanel != diagnosticsPanelBase) {
            removeCurrentDiagnosticsPanel();
            VCCIDashBoard.ref().showRightSidePanel(diagnosticsPanelBase, uiObj, false);
            diagnosticsPanelBase.panelShownNotification();
            jCurrentDiagnosticsPanel = diagnosticsPanelBase;
            jCurrentDFSManager = null;
            jCurrentDFSConfigurationPanel = null;
        }
    }

