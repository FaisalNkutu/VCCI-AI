        String newFolderName = jAddFolderPanel.getFolderName();
        DFolder parentFolder = jAddFolderPanel.getParentFolder();

        if (parentFolder == null) {
            parentFolder = jHiddenFolder;
        }
        DFolder folder = new DFolder(
                DBConstants.INVALID_ID,
                parentFolder == null ? DBConstants.INVALID_ID : parentFolder.getFolderId(),
                newFolderName,
                GFolder.FOLDER_CATEGORY_CODE_NOS,
                GFolder.FOLDER_COMPLETE_CODE_YES);
        folder.setIsComplete(true);

