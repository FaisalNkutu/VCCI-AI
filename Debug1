                Request.CRUDMarker.CREATE,
                CreateUpdateFolderRequest.UpdateType.ADD,
                folder,
                parentFolder);

        ParadigmSwingUIDirector.jUIDirector.issueFeatureRequest(this,
                VCCIDashBoard.getCurrentExercise().getBrokerKey(),
