    private boolean setSpecialDataflowVariables(DDataFlowSpecification dfs) {
        String flow = dfs.getDataFlowSpecificationName();
        if (Constants.CA_ROUTER.equals(flow)) {
            jDISRouterStarted = true;
            jDISRouterDataflow = dfs;
            return true;
        } else if (Constants.CA_DISAGGREGATION.equals(flow)) {
            jDisaggregationDataflow = dfs;
            TransferCommand tc = TransferCommand.buildCommand(BaseConstants.UI_PLAY);
            if (tc != null) {
                MediationCommandsRequest mcr = new MediationCommandsRequest();
                mcr.addDataFlowCommand(dfs.getDataFlowSpecificationIndex(), tc);
                ParadigmSwingUIDirector.jUIDirector.issueFeatureRequest(this,
                        VCCIDashBoard.getCurrentExercise().getBrokerKey(),
                        VCCIControlPanel.class
                                .getCanonicalName(),
                        MediationService.class
                                .getCanonicalName(),
                        MediationService.ISSUE_COMMANDS, mcr, true);
            }
            jDisaggregationStarted = true;
            return true;
        } else if (Constants.CA_GIS.equals(flow)) {
            jGISDataflow = dfs;
            TransferCommand tc = TransferCommand.buildCommand(BaseConstants.UI_PLAY);
            if (tc != null) {
                MediationCommandsRequest mcr = new MediationCommandsRequest();
                mcr.addDataFlowCommand(dfs.getDataFlowSpecificationIndex(), tc);
                ParadigmSwingUIDirector.jUIDirector.issueFeatureRequest(this,
                        VCCIDashBoard.getCurrentExercise().getBrokerKey(),
                        VCCIControlPanel.class
                                .getCanonicalName(),
                        MediationService.class
                                .getCanonicalName(),
                        MediationService.ISSUE_COMMANDS, mcr, true);
            }
            jGISStarted = true;
            return true;
        } else if (Constants.CA_EMULATION.equals(flow)) {
            // Something about Emulation goes here!
            jEmulationStarted = true;
            return true;
        } else if (Constants.CA_OTH_SERVER.equals(flow)) {
            jOthGoldServerDataflow = dfs;
