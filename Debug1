    public static boolean isFirstWorseThanSecond(
            NodeMarking m1,
            NodeMarking m2) {
        switch (m1) {
            case NORMAL:
                switch (m2) {
                    case NORMAL:
                    case ERROR:
                    case WARNING:
                    case UNKNOWN:
                        return false;
                }
                break;
            case ERROR:
                switch (m2) {
                    case ERROR:
                        return false;
                    case NORMAL:
                    case WARNING:
                    case UNKNOWN:
                        return true;
                }
                break;
            case WARNING:
                switch (m2) {
                    case NORMAL:
                    case UNKNOWN:
                        return true;
                    case ERROR:
                    case WARNING:
                        return false;
                }
                break;
            case UNKNOWN:
                switch (m2) {
                    case NORMAL:
                        return true;
                    case ERROR:
                    case WARNING:
                    case UNKNOWN:
                        return false;
                }
                break;

        }
        return false;
    }

    public static String markingToString(NodeMarking m) {
        switch (m) {
            case NORMAL:
                return "NORMAL";
            case ERROR:
                return "ERROR";
            case WARNING:
                return "WARNING";
            case UNKNOWN:
                return "UNKNOWN";
        }
        return null;
    }

