        OptionPaneResponse opr = VCCIDashBoard.ref().inlineOptionPaneRequest(OptionsPane.PromptType.PROMPT_YES_NO, err);
        if (opr.isYesSelected()) {
            if (ParadigmSwingUIDirector.jUIDirector != null) {
