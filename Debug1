    @Override
    public void nodeDropped(
            IVCCIUIControlObject node,
            IVCCIUIControlObject newParent) {
        // See if parent is changing or not
        if (node.getParentControlObject() == null && newParent == null) {
            return;
        }
        // If the new parent is null or a dataflow - then we will just reparent the
        // node to the root folder if it that is not already the parent
        if (node.getParentControlObject() == null && newParent != null) {
            if (!newParent.isFolder()) {
                // We are dropping an object that already is child of root unto
                // a data flow or connection - so no change in parent
                return;
            }
        }

        // Dragged node is either a folder or a connection
        DFolder draggedFolder = null;
        DConnection draggedConn = null;
        if (node.isFolder()) {
            draggedFolder = node.getFolder();
        } else {
            draggedConn = node.getConnection();
        }

        DFolder targetFolder = null;
        if (newParent == null || !newParent.isFolder()) {
            // Leave targetFolder as null
        } else {
            targetFolder = newParent.getFolder();
        }
        if (draggedFolder != null) {
            DFolder df_clone = draggedFolder.clone();
            df_clone.setFolderParentFolderId(targetFolder == null ? jHiddenFolder.getFolderId() : targetFolder.getFolderId());

            CreateUpdateFolderRequest cufr = new CreateUpdateFolderRequest(
                    Request.CRUDMarker.UPDATE,
                    CreateUpdateFolderRequest.UpdateType.UPDATE_ATTRIBUTES,
                    df_clone,
                    draggedFolder);

            cufr.setCRUDMarker(Request.CRUDMarker.UPDATE);

            ParadigmSwingUIDirector.jUIDirector.issueFeatureRequest(this,
                    VCCIDashBoard.getCurrentExercise().getBrokerKey(),
                    VCCIControlPanel.class
                            .getCanonicalName(),
                    MediationService.class
                            .getCanonicalName(),
                    MediationService.CREATE_UPDATE_FOLDER, cufr, true);
        } else if (draggedConn != null) {
            DConnection conn_clone = draggedConn.clone();
            conn_clone.setConnectionFolderId(targetFolder == null
                    ? jHiddenFolder.getFolderId()
                    : targetFolder.getFolderId());

            CreateUpdateConnectionRequest cudcr = new CreateUpdateConnectionRequest(
                    conn_clone, true);
            cudcr.setCRUDMarker(BTO.CRUDMarker.UPDATE);
            cudcr.setOnlyFolderIDAffected(true);

            ParadigmSwingUIDirector.jUIDirector.issueFeatureRequest(this,
                    VCCIDashBoard.getCurrentExercise().getBrokerKey(),
                    VCCIControlPanel.class
                            .getCanonicalName(),
                    MediationService.class
                            .getCanonicalName(),
                    MediationService.CREATE_UPDATE_CONNECTION, cudcr, true);
        }
    }

