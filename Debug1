    public void processFolderNotification(FolderNotification notification) {
        if (jHiddenFolder == null || jInternalFolder == null) {
            // Added for Automated testing - timing issue
            return;
        }
        if (!VCCIDashBoard.jVCCIDashBoard.isSystemReady()) {
            return;
        }
        DFolder dFolder = notification.getFolder();
        if (dFolder == null) {
            return;
        }

        IVCCIUIControlObject uiObj
                = jVCCITreeDisplayPanel.getFolderControlObject(dFolder.getFolderId());

        if (notification.isUpdate()) {
            if (uiObj != null) {
                // Update Case
                jVCCITreeDisplayPanel.updateFolder(dFolder);

                uiObj.setControlObjectName(dFolder.getFolderName());

                // And update status of folder
                updateFolderStatus(uiObj);
            } else // This should be the hidden folder or internal folder
                if (isInternalOrHiddenFolder(dFolder)) {
                    jVCCITreeDisplayPanel.updateFolder(dFolder);
                }
        } else if (notification.isCreate()) {
            // See where we need to add it
            long parentId = dFolder.getFolderParentFolderId();
            IVCCIUIControlObject parentObj
                    = jVCCITreeDisplayPanel.getFolderControlObject(parentId);

            addFolderNode(parentObj, dFolder);
            // And update status of folder
            updateFolderStatus(parentObj);
        } else if (notification.isDelete()) {
            // Might be null if multiple folders have been deleted and we get
            // notifications out of order so handle that case
            if (uiObj != null) {
                jVCCITreeDisplayPanel.deleteFolder(dFolder);

                // Update parent status
                IVCCIUIControlObject parentObj = uiObj.getParentControlObject();
                if (parentObj != null) {
                    updateFolderStatus(parentObj);
                }
            }
            if (jCurrentFolder == dFolder) {
                jCurrentFolder = null;
            }
        }
    }

    private boolean isInternalOrHiddenFolder(DFolder folder) {
        if (folder == null) {
            return false;
        }
        long id = folder.getFolderId();
        if (jHiddenFolder == null || jInternalFolder == null) {
            // Added for Automated testing - timing issue
            return false;
        }
        return id == jHiddenFolder.getFolderId() || id == jInternalFolder.getFolderId();
    }

    public void connectionUpdatedNotify(DConnection conn) {
        // Find all dataflows using this connection and update the
        // reference to this copy. We can call the following method because
        // the id would not have changed
        LinkedList<DDataFlowSpecification> dataflows = getDataflowsUsingConnection(conn);
        for (DDataFlowSpecification dfs : dataflows) {
