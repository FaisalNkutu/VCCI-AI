    public @Override
    boolean allowPopup(final IVCCIUIControlObject uiObj) {
        if (uiObj != null) {
            if (uiObj.isFolder()) {
                // Set up Folder popup
                jCurrentPopup = jVCCITreeDisplayPanel.getPopup();
                jCurrentPopup.removeAll();
                JMenuItem mi = new JMenuItem("Add Folder");
                jCurrentPopup.add(mi);
                mi.addActionListener(evt -> {
                    // Add Folder
                    addFolderAction(uiObj);
                });
                mi = new JMenuItem("Delete Folder");
                jCurrentPopup.add(mi);
                mi.addActionListener(evt -> {
                    // Delete Folder
                    deleteFolderAction(uiObj);
                });
                return true;
            } else if (uiObj.isDataFlow()) {
                jCurrentPopup = jVCCITreeDisplayPanel.getPopup();
                jCurrentPopup.removeAll();
                JMenuItem mi = new JMenuItem("Delete Dataflow");
                jCurrentPopup.add(mi);
                mi.addActionListener(evt -> {
                    // Delete Dataflow
                    deleteDataflowAction(uiObj);
                });

                // Allow manager to add popup entries
                DDataFlowSpecification dfs = uiObj.getDataFlow();
                if (dfs != null) {
                    DataFlowManager dfsMgr = getDataflowManager(dfs);
                    if (dfsMgr != null) {
                        dfsMgr.buildPopup(jCurrentPopup);
                    }
                }
                return true;
            } else {
                // Connection case
                jCurrentPopup = jVCCITreeDisplayPanel.getPopup();
                jCurrentPopup.removeAll();
                JMenuItem mi = new JMenuItem("Delete Connection");
                jCurrentPopup.add(mi);
                mi.addActionListener(evt -> deleteConnectionAction(uiObj));
                // Allow connection manager to add the popup entries
                DConnection dc = uiObj.getConnection();
                ConnectionManager mgr = getConnectionManager(dc);
                if (mgr != null) {
                    mgr.buildPopup(jCurrentPopup);
                }

                // And we also add any popup entries from the connection type
                // manager (if one exists)
                DConnectionType dct = getConnectionType(dc);
                if (dct != null) {
                    configureConnectionTypesPopup(dct, jCurrentPopup);
                }

                return true;
            }
        } else // User is in open area of the tree
            // Set up Folder popup if a syndicate is currently being
            // viewed
            if (VCCIDashBoard.getCurrentExercise() != null) {
                jCurrentPopup = jVCCITreeDisplayPanel.getPopup();
                jCurrentPopup.removeAll();
                JMenuItem mi = new JMenuItem("Add Folder");
                jCurrentPopup.add(mi);
                mi.addActionListener(evt -> {
                    // Add Folder
                    addFolderAction(uiObj);
                });
                return true;
            }
        return false;
    }

