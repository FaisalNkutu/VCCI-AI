    // Note: This is a critical method that MUST be implemented correctly so that
    // data is not left initialized if connection to a remote exercise is lost
    // - for that reason it is put right next to the class IVs
    public void clear() {
        jCurrentConnection = null;
        jCurrentFolder = null;
        clearToolBar();

        // Clear out subscriptions
        if (jDFSManagersHash != null) {
            LinkedList<DataFlowManager> mgrs = new LinkedList<>(jDFSManagersHash.values());
            for (DataFlowManager mgr : mgrs) {
                mgr.removeObjectManagerSubscriptions();
                ParadigmSwingUIDirector.jUIDirector.removeObjectNotificationSubscriptions(mgr);
            }
        }

        if (jDisaggregationTemplateManager != null) {
            ParadigmSwingUIDirector.jUIDirector.removeObjectNotificationSubscriptions(jDisaggregationTemplateManager);
        }

        if (jControlFeatureManager != null) {
            ParadigmSwingUIDirector.jUIDirector.removeObjectNotificationSubscriptions(jControlFeatureManager);
        }

        if (jFolderToDiagnosticsPanelHash != null) {
            LinkedList<DiagnosticsPanelBase> diags = new LinkedList<>(jFolderToDiagnosticsPanelHash.values());
            for (DiagnosticsPanelBase diag : diags) {
                ParadigmSwingUIDirector.jUIDirector.removeObjectNotificationSubscriptions(diag);
            }
        }

        if (jDisaggregationFilterPanel != null) {
            ParadigmSwingUIDirector.jUIDirector.removeObjectNotificationSubscriptions(jDisaggregationFilterPanel);
            jDisaggregationFilterPanel = null;
        }

        if (jDFSManagersHash != null) {
            // Allow data flow managers to clear graphics
            LinkedList<DataFlowManager> dfMgrs = new LinkedList<>(jDFSManagersHash.values());
            for (DataFlowManager obj : dfMgrs) {
                obj.cleanupGraphics();
            }
        }

        if (jConnectionManagersHash != null) {
            LinkedList<ConnectionManager> mgrs = new LinkedList<>(jConnectionManagersHash.values());

            for (ConnectionManager mgr : mgrs) {
                mgr.removeObjectManagerSubscriptions();
                ParadigmSwingUIDirector.jUIDirector.removeObjectNotificationSubscriptions(mgr);
            }
        }

        if (jConnTypeManagersHash != null) {
            LinkedList<ConnectionTypeManager> mgrs = new LinkedList<>(jConnTypeManagersHash.values());
            for (ConnectionTypeManager mgr : mgrs) {
                mgr.removeObjectManagerSubscriptions();
                ParadigmSwingUIDirector.jUIDirector.removeObjectNotificationSubscriptions(mgr);
                mgr.cleanupGraphics();
            }
        }

        if (jConnToDiagnosticsPanelHash != null) {
            LinkedList<DiagnosticsPanelBase> diags = new LinkedList<>(jConnToDiagnosticsPanelHash.values());
            for (DiagnosticsPanelBase diag : diags) {
                ParadigmSwingUIDirector.jUIDirector.removeObjectNotificationSubscriptions(diag);
            }
        }

        if (jConnToMappingAndRoutingPanelHash != null) {
            LinkedList<ConnectionManager> mgrs = new LinkedList<>(jConnToMappingAndRoutingPanelHash.values());
            for (ConnectionManager mgr : mgrs) {
                mgr.removeObjectManagerSubscriptions();
                ParadigmSwingUIDirector.jUIDirector.removeObjectNotificationSubscriptions(mgr);
            }
        }

        if (jConnectionManagersHash != null) {
            // Allow connection and connection type managers to clear graphics
            LinkedList<ConnectionManager> cMgrs = new LinkedList<>(jConnectionManagersHash.values());
            for (ConnectionManager obj : cMgrs) {
                obj.cleanupGraphics();
            }
        }

        if (jRAPManager != null) {
            jRAPManager.processManagerMessage(new RAPTerminateRAPStatusUICapabilityManagerMessage());
        }

        jDFSManagersHash = new LinkedHashMap<>();
        jCurrentPopup = new JPopupMenu();
        jFolderToDiagnosticsPanelHash = new LinkedHashMap<>();
        jCenterPanel.removeAll();
        jCenterPanel.add(jVCCITreeDisplayPanel, BorderLayout.CENTER);
        jSystemCapabilities = new LinkedList<>();
        jHiddenFolder = null;
        jInternalFolder = null;
        jDISRouterStarted = false;
        jDisaggregationStarted = false;
