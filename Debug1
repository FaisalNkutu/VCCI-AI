    @Override
    public boolean allowDrop(
            IVCCIUIControlObject node,
            IVCCIUIControlObject dropTarget) {
        // Cannot drop on self
        if (node == dropTarget) {
            return false;
        }
        Object dest = null;
        if (dropTarget != null) {
            dest = dropTarget.getDomainObject();
            if (dest == null) {
                return false;
            }
            // Make sure destination is not a descendant - note that we only
            // care about folders here - if the drop is on a data flow node
            // or connection we interpret that to be open space and move the node to the
            // topmost level
            if (dropTarget.isFolder() && node.isFolder()) {
                if (jVCCITreeDisplayPanel.isDescendant(dropTarget, node)) {
                    return false;
                }
            }
        }
        return true;
    }

