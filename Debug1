    protected void issueCommand(
            IVCCIUIControlObject uiObj,
            Object obj,
            long id,
            String command) {
        // Handle commands
        if (obj instanceof DDataFlowSpecification) {
            if (BaseConstants.UI_CONFIGURE.equals(command)) {
                DDataFlowSpecification dfs = (DDataFlowSpecification) obj;

                // Are we just editing the same one again?
                if (jCurrentDFSConfigurationPanel != null) {
                    DDataFlowSpecification check = jCurrentDFSConfigurationPanel.getDFS();
                    if (check != null) {
                        if (check.getDataFlowSpecificationIndex() == dfs.getDataFlowSpecificationIndex()) {
                            return;
                        }
                    }
                    if (jCurrentDFSConfigurationPanel.isEdited()) {
                        String err = "Current Dataflow has been edited - are you sure you want to lose edits?";
                        OptionPaneResponse opr = VCCIDashBoard.ref().inlineOptionPaneRequest(OptionsPane.PromptType.PROMPT_YES_NO, err);
                        if (!opr.isYesSelected()) {
                            return;
                        }
                    }
                }

                AddDFSPanel p = null;
                // Check to see if this dataflow's connection is complete or not
                DConnection dc = dfs.getConnection();
                if (dc != null && !dc.isComplete()) {
                    ParadigmSwingUIDirector.jUIDirector.showApplicationErrorMessage(
                            "You must first configure the connection ("
                                    + dc.getConnectionName()
                                    + ") that supports this Dataflow");
                    return;
                }
                p = new AddDFSPanel(((DDataFlowSpecification) obj));
                jCurrentDFSConfigurationPanel = p;
                VCCIDashBoard.ref().showRightSidePanel(p, uiObj, false);
                uiObj.setControlObjectHighlighted(true);
                // This has to be done after the above process call so that the
                // VCCIPanel is set on the form along with the buttons
                p.startDFSEdit();
                jCurrentDiagnosticsPanel = null;
                // We do this here again as the showRightSidePanel() call reset this
                jCurrentDFSConfigurationPanel = p;
            } else if (BaseConstants.UI_DIAGNOSTICS.equals(command)) {
                showDataflowDiagnostics(uiObj, (DDataFlowSpecification) obj);
            } else if (BaseConstants.UI_MAPPING_AND_ROUTING.equals(command)) {
                dfsManagerAction(uiObj, (DDataFlowSpecification) obj);
            } else if (BaseConstants.UI_PLAY.equals(command)
                    || BaseConstants.UI_PAUSE.equals(command)
                    || BaseConstants.UI_CLEAR.equals(command)) {

                TransferCommand tc = TransferCommand.buildCommand(command);
                if (tc != null) {
                    MediationCommandsRequest mcr = new MediationCommandsRequest();
                    mcr.addDataFlowCommand(id, tc);
                    ParadigmSwingUIDirector.jUIDirector.issueFeatureRequest(this,
                            VCCIDashBoard.getCurrentExercise().getBrokerKey(),
                            VCCIControlPanel.class
                                    .getCanonicalName(),
                            MediationService.class
                                    .getCanonicalName(),
                            MediationService.ISSUE_COMMANDS, mcr, true);
                }
            } else {
                // Allow dataflow manager to handle any others
                DataFlowManager dfm = getDataflowManager((DDataFlowSpecification) obj);
                if (dfm != null) {
                    dfm.iconButtonPressed(command);
                }
            }
        } else if (obj instanceof DConnection) {
            DConnection conn = (DConnection) obj;
            if (BaseConstants.UI_CONFIGURE.equals(command)) {
                // Show connection configuration panel here
                configureConnection(
                        uiObj,
                        conn,
                        getConnectionTypeByConnectionTypeId(conn.getConnectionTypeId()));
            } else if (BaseConstants.UI_DIAGNOSTICS.equals(command)) {
                jCurrentConnection = conn;
                // Show diagnostics panel here
                showConnectionDiagnostics(
                        uiObj,
                        getConnectionTypeByConnectionTypeId(conn.getConnectionTypeId()).getConnectionTypeName(),
                        conn);
            } else if (BaseConstants.UI_CONNECT.equals(command)) {
                jCurrentConnection = conn;
                // Just a connect/reconnect request
                CreateUpdateConnectionRequest cucr = new CreateUpdateConnectionRequest(conn, true);
                cucr.setCRUDMarker(Request.CRUDMarker.UPDATE);

                ParadigmSwingUIDirector.jUIDirector.issueFeatureRequest(this,
                        VCCIDashBoard.getCurrentExercise().getBrokerKey(),
                        VCCIControlPanel.class
                                .getCanonicalName(),
                        MediationService.class
                                .getCanonicalName(),
                        MediationService.CREATE_UPDATE_CONNECTION, cucr, true);

            } else if (BaseConstants.UI_MAPPING_AND_ROUTING.equals(command)) {
                showMappingAndRoutingPanel(uiObj, conn);
            }
        } else if (BaseConstants.UI_DIAGNOSTICS.equals(command)) {
            showFolderDiagnostics(uiObj, (DFolder) obj);
        } else if (BaseConstants.UI_CONFIGURE.equals(command)) {
            // All we can do with a folder is edit the name
            clearButtonPanelHighlights();
        } else if (BaseConstants.UI_PLAY.equals(command)
                || BaseConstants.UI_PAUSE.equals(command)
                || BaseConstants.UI_CLEAR.equals(command)) {

            TransferCommand tc = TransferCommand.buildCommand(command);
            if (tc != null) {
                MediationCommandsRequest mcr = new MediationCommandsRequest();
                mcr.addFolderCommand(id, tc);
                ParadigmSwingUIDirector.jUIDirector.issueFeatureRequest(this,
                        VCCIDashBoard.getCurrentExercise().getBrokerKey(),
                        VCCIControlPanel.class
                                .getCanonicalName(),
                        MediationService.class
                                .getCanonicalName(),
                        MediationService.ISSUE_COMMANDS, mcr, true);
            }
        }
    }

    private void configureConnection(
            IVCCIUIControlObject uiObj,
            DConnection conn,
            DConnectionType connType) {

        // Are we just editing the same one again?
        if (jCurrentConnectionConfigurationPanel != null) {
            DConnection check = jCurrentConnectionConfigurationPanel.getConnection();
            if (check != null && conn != null) {
                if (check.getConnectionId() == conn.getConnectionId()) {
                    return;
                }
            }
            if (jCurrentConnectionConfigurationPanel.isEdited()) {
                String err = "Current connection has been edited - are you sure you want to lose edits?";
                OptionPaneResponse opr = VCCIDashBoard.ref().inlineOptionPaneRequest(OptionsPane.PromptType.PROMPT_YES_NO, err);
                if (!opr.isYesSelected()) {
                    return;
                }
            }
        }
        // Determine the type of form
        ConnectionConfigurationPanelBase p = ConnectionConfigurationPanelBase.generateDerivedForm(null, conn, connType);
        if (p == null) {
