    public boolean isValidUIName(String name) {
        if (name == null) {
            return false;
        }
        name = name.trim();
        if (name.length() == 0) {
            return false;
        }

        // Now make sure we have valid characters
        // Check for bad charaters
        Pattern p = Pattern.compile(INVALID_CHARS);
        final Matcher m = p.matcher(name);
        if (m.find()) {
            return false;
        }
        return true;
    }

    protected void initializeDataFlowManager(
            IVCCIUIControlObject uiObj,
            DDataFlowSpecification dfs,
            DConnection dc,
            DSystemCapability df) {
        // Now depending on the connection type and function create the proper
        // DataFlow Manager

        DConnectionType dct;
        if (dc != null) {
            dct = getConnectionType(dc);
            if (dct == null) {
                jL.warn("initializeDataFlowManager - cannot add Dataflow node for {} : Connection type is null", dc.getConnectionName());
                return;
            }

            if (df != null) {

                String functionName = df.getSystemCapabilityName();
                String functionCatCode = df.getSystemCapabilityCategoryCode();
                String connTypeName = dct.getConnectionTypeName();

                String key = connTypeName + ":" + functionName + ":" + functionCatCode;
                DataFlowManager dfMgr = null;
                // Retrieve the connection type manager (might be null)

                ConnectionTypeManager ctm = getConnectionTypeManager(getConnectionTypeByConnectionTypeId(dc.getConnectionTypeId()));

                if (jDataflowManagerLookupHash.containsKey(key)) {
                    String handlerClass = jDataflowManagerLookupHash.get(key);
                    try {
                        Class<?> c = Class.forName(handlerClass, false, Thread.currentThread().getContextClassLoader());
                        Constructor<?> ctor = c.getConstructor(
                                DDataFlowSpecification.class,
                                IVCCIUIControlObject.class,
                                ConnectionTypeManager.class
                        );
                        dfMgr = (DataFlowManager) ctor.newInstance(dfs, uiObj, ctm);
                        jDFSManagersHash.put(dfs.getDataFlowSpecificationIndex(), dfMgr);
                        dfMgr.initialize(dfs.isComplete());
                    } catch (ClassNotFoundException | NoSuchMethodException | SecurityException
                             | InstantiationException | IllegalAccessException | IllegalArgumentException
                             | InvocationTargetException ex) {
                        jL.error(ex.getMessage(), ex);
                        VCCIDashBoard.setError(ex.getMessage());
                    }
                }

                if (dfMgr == null) {
                    VCCIDashBoard.setWarning("No Dataflow manager : connection type[" + connTypeName + "] capability[" + functionName + "]");

                    if (uiObj != null) {
                        uiObj.addButton(BaseConstants.UI_DIAGNOSTICS, CommonIcons.jDiagnostics16x16Icon, "Diagnostics", "Diagnostics", functionName);
                        uiObj.addButton(BaseConstants.UI_PLAY, CommonIcons.jPlay16x16Icon, "Play", "Play", functionName);
                        uiObj.addButton(BaseConstants.UI_PAUSE, CommonIcons.jPause16x16Icon, "Pause", "Pause", functionName);
                        uiObj.addButton(BaseConstants.UI_CONFIGURE, CommonIcons.jSettings16x16Icon, "Configure", "Configure", functionName);
                        uiObj.addButton(BaseConstants.UI_MAPPING_AND_ROUTING, CommonIcons.jMapping16x16Icon, "Mapping & Routing", "Mapping", functionName);
                    }
                }
            }
        }
    }

    public void setConnectionTypes(LinkedList<DConnectionType> cTypes) {
        jConnectionTypes = cTypes;
        // pruning any connection types from this list that are not in the system classpath
        // jConnectionTypes holds ALL connections that VCCI is able to make, but does not account
        // for what the user is licensed for. This method removes any unlicensed adaptors from this list,
        // but they maintain in the database.
        pruneUnlicensedConnectionTypes();
    }

    /**
     * Removes any connection types from jConnectionTypes that are not on the system classpath
     * - AKA that the user is not licensed to use
     */
    private void pruneUnlicensedConnectionTypes() {
        ListIterator<DConnectionType> iterator = jConnectionTypes.listIterator();
        while (iterator.hasNext()) {
            DConnectionType cType = iterator.next();
            Constructor<?> ctor = null;
            try {
                // determine if connection class is on the classpath
                Class<?> c = Class.forName(cType.getConnectionTypeComponentName(), false, Thread.currentThread().getContextClassLoader());
                ctor = c.getConstructor();
            } catch (Exception ex) {
                // connection class is not on the classpath - remove from connection type list
                jL.warn("Connection Type <{}> removed : Adaptor not available.", cType);
                iterator.remove();
            }
        }
    }

