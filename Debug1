    private void handleUIControlObjectButtonClick(IVCCIUIControlObject uiObj,
                                                  String identifier) {
        if (uiObj.isDataFlow()) {
            DDataFlowSpecification dfs = uiObj.getDataFlow();
            jCurrentDataFlow = dfs;
            issueCommand(uiObj, dfs, dfs.getDataFlowSpecificationIndex(), identifier);
        } else if (uiObj.isConnection()) {
            DConnection dc = uiObj.getConnection();
            jCurrentConnection = dc;
            issueCommand(uiObj, dc, dc.getConnectionId(), identifier);
        } else if (uiObj.isFolder()) {
            DFolder folder = uiObj.getFolder();
            issueCommand(uiObj, folder, folder.getFolderId(), identifier);
        }
    }

