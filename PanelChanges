                    "DEBUG VCCI: requestAIServiceAgents() issued");

            Window window =
                    SwingUtilities.getWindowAncestor(this);

            Frame owner = null;

            if (window instanceof Frame) {
                owner = (Frame) window;
            }

            AIChatbotClient chatbot =
                    new AIChatbotClient(owner);

            chatbot.setLocationRelativeTo(owner);

            chatbot.setVisible(true);
