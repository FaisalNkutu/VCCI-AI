        private void requestAIServiceAgents() {

        try {

            System.out.println(
                    "DEBUG VCCI: Sending AIService.LIST request...");

            AISGetCommandsRequest request =
                    new AISGetCommandsRequest();

            ParadigmSwingUIDirector.jUIDirector.issueFeatureRequest(
                    this,
                    VCCIDashBoard.getCurrentExercise().getBrokerKey(),
                    VCCIControlPanel.class.getCanonicalName(),
                    AIService.class.getCanonicalName(),
                    AIService.LIST,
                    request,
                    true);

            System.out.println(
                    "DEBUG VCCI: AIService.LIST request issued.");

        } catch (Exception ex) {

            System.err.println(
                    "DEBUG VCCI: Failed to issue AIService.LIST request.");

            ex.printStackTrace();
        }
        }
