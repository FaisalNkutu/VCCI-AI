    public int auditQueues(boolean printQueueContents) {
        try {
            if (jCurrentUIObjectBeingProcessed != null) {
                String report = "CURRENT OBJECT BEING PROCESSED : ";
                String name = getName(jCurrentUIObjectBeingProcessed);
                report += name;
                report += " REF[" + Integer.toHexString(System.identityHashCode(jCurrentUIObjectBeingProcessed)) + "]";
                System.err.println(report.toString());
            }
        } catch (Exception ex) {
            // Ignore
        }
        if (printQueueContents) {
            AuditUtil.auditQueue(getUIComponent().getClass(), "UI Priority Queue", jUIPriorityQueue);
            AuditUtil.auditQueue(getUIComponent().getClass(), "UI Message Queue", jUIMessageQueue);
        }
        int queueSize = getUIComponent().auditQueues(printQueueContents);
        return queueSize + jUIPriorityQueue.size() + jUIMessageQueue.size();
    }

    /**
     * This method will provide a summary audit report of what is in the queue
     *
     * @param queue A reference to the queue being processed
     */
    public LinkedHashMap<String, Long> getQueueContent(LinkedBlockingQueue<Object> queue) {
        LinkedHashMap<String, Long> numByName = new LinkedHashMap<String, Long>();
        for (Object object : queue) {
            String objName = getName(object);
            Long numObjs = numByName.get(objName);
            long num = 1L;
            if (numObjs != null) {
                num += numObjs.longValue();
            }
            numByName.put(objName, num);
        }
        return numByName;
    }

    /**
     * A method used to get a representative name for the supplied object
     *
     * @param object A reference to the object whose name is being requested
     *
     * @return A representative name for the supplied object
     */
    private static String getName(Object object) {
        String preQualifier = "";
        String name = "";
        String postQualifier = "";
        if (object instanceof DispatchUINotification) {
            DispatchUINotification duin = (DispatchUINotification) object;
            UINotification uin = duin.getUINotification();
            if (uin != null) {
                BrokerKey bk = uin.getBrokerKey();
                if (bk != null) {
                    preQualifier = bk.getDisplayName(true);
                }
                if (uin.getObject() != null) {
                    object = uin.getObject();
                }
            }
        } else if (object instanceof DispatchFRR) {
            DispatchFRR dfrr = (DispatchFRR) object;
            FeatureRequestResponse frr = dfrr.getFRR();
            if (frr != null) {
                BrokerKey bk = frr.getBrokerKey();
                if (bk != null) {
                    preQualifier = bk.getDisplayName(true);
                }
                postQualifier = frr.getSrcComponentKey().getComponentID() + "->"
                        + frr.getDstComponentID() + ":" + frr.getComponentFeatureID();
            }
        }

        if (object instanceof DisplayableContent) {
            DisplayableContent dc = (DisplayableContent) object;
            ModelObject content = dc.getContent();
            if (content != null) {
                name = dc.getSourceComponentID() + ":" + content.getClass().getCanonicalName();
            } else {
                name = dc.getSourceComponentID() + ":" + dc.getClass().getCanonicalName();
            }
        } else {
            name = object.getClass().getCanonicalName();
        }
        return preQualifier + ":" + name + ":" + postQualifier;
    }

    private void reportTime(
            Object obj,
            long time) {
        if (!jTimeReportingIsOn) {
            return;
        }
        long end = System.currentTimeMillis();
        long elapsed = end - time;
        if (elapsed > jProcessingTimeLimitMS) {
            BTO bto;
            if (obj instanceof DispatchUINotification) {
                DispatchUINotification dui = (DispatchUINotification) obj;
                bto = dui.getUINotification().getObject();
            } else {
                DispatchFRR dfrr = (DispatchFRR) obj;
                bto = dfrr.getFRR().getFeatureParameters();
            }
            if (jIAdminPanelDataReceiver != null) {
                jIAdminPanelDataReceiver.uiMonitorUpdate(
                        bto.getClass().getCanonicalName(),
                        "" + elapsed);
            }
        }
    }

    protected void processMessage(Object obj) {

        if (obj != null) {
            long start = System.currentTimeMillis();
            jCurrentUIObjectBeingProcessed = obj;
            if (obj instanceof DispatchFRR) {
                DispatchFRR msg = (DispatchFRR) obj;
                FeatureRequestResponse frr = msg.getFRR();
                if (jAppUIProvider.shouldProcessFRR(frr)) {
                    IFRREnabled caller = msg.getFRRCaller();
                    if (jUIDelegate.jUIComponent.processError(frr, false, true)) {
                        caller.processRequestFailed(frr);
                        reportTime(obj, start);
                    } else if (frr.getComponentFeatureID().equals(UI.CONFIRM_PROCESSING)) {
                        processConfirmationRequest(frr);
                    } else {
                        processFRR(caller, frr, obj);
                        reportTime(obj, start);
                    }
                }
                return;
            }
            if (obj instanceof DispatchUINotification) {
                DispatchUINotification msg = (DispatchUINotification) obj;
                IUINotificationEnabled subscriber;

                if(msg.jUINotification.getObject() instanceof InvalidNetworkAdaptorsCarrier inac){
                    // if there are problems with network adaptor IP's in current database
                    if (inac.hasProblemAdaptors()) {
                        // open UI to allow user to update the network adaptor IP's
                        openIPCorrectionDialog(inac);
                    }
                    // processing updated network adaptor values - this processing needs to occur
                    // even if there are no problem adaptors as this function sends the request
                    // to the OM Adaptor which eventually results in setReadyToRun() being triggered
                    processUpdatedNetworkAdaptors();
                }

                if (jAppUIProvider != null) {
                    subscriber = msg.getSubscriber();
                    if (subscriber != null && !subscriber.isDeactivated()) {
                        processUINotification(msg);
                        reportTime(obj, start);
                    }
                }
            } else {
                jL.warn( "Unknown object passed to UIDirector : " + obj.getClass().getCanonicalName());
            }
        }
    }

    /**
     * Opens the IP Correction dialog and populates it with all problematic network adaptor values
     * and their respective connections.
     *
     * @param inac InvalidNetworkAdaptorsCarrier object, which is used to populate the UI
     */
    private void openIPCorrectionDialog(InvalidNetworkAdaptorsCarrier inac){
        jIpCorrectionDialog = new IPCorrectionDialog(inac);
        jIpCorrectionDialog.pack();
        jIpCorrectionDialog.setLocationRelativeTo(null);
        jIpCorrectionDialog.setVisible(true);
        jIpCorrectionDialog.toFront();
        jIpCorrectionDialog.requestFocus();
    }

    /**
     * Sends request with updated network adaptor sim params to OM Adaptor to be updated in the DB.
     * If no sim params to update, sends request with empty list as the frr params. This gets handled in the backend.
     * This request NEEDS to be sent to allow for startup to continue.
     */
    private void processUpdatedNetworkAdaptors(){
        UpdateNetworkAdaptorsUponDBReloadRequest updateRequest = new UpdateNetworkAdaptorsUponDBReloadRequest();
        // we expect jIpCorrectionDialog to be null if there are no problem parameters to update
        if(jIpCorrectionDialog != null) {
            updateRequest.setUpdateSimParams(jIpCorrectionDialog.getUpdatedNetworkAdaptorParams());
            updateRequest.setUpdateDISRoutes(jIpCorrectionDialog.getUpdatedNetworkAdaptorDISRoutes());
        }

        jUIDirector.issueFeatureRequest(null,
                jUIDirector.getAppUIProvider().getBrokerKey(),
                ParadigmSwingUIDirector.class.getCanonicalName(),
                MasterOMAdaptor.class.getCanonicalName(),
                MasterOMAdaptor.UPDATE_NETWORK_ADAPTORS_UPON_DB_RELOAD,
                updateRequest,
                false);
    }

    protected void processFRR(IFRREnabled caller, FeatureRequestResponse frr, Object obj) {
        long before = System.currentTimeMillis();
        caller.processResponse(frr);
        long time = System.currentTimeMillis() - before;

        DispatchFRR dfrr = (DispatchFRR) obj;
        BTO bto = dfrr.getFRR().getFeatureParameters();
        recordStat(bto, time);
    }

    protected void processUINotification(DispatchUINotification msg) {
        long before = System.currentTimeMillis();
        jAppUIProvider.processNotification(
                msg.getSubscriber(),
                msg.getUINotification());
        long time = System.currentTimeMillis() - before;

        BTO bto = msg.getUINotification().getObject();
        recordStat(bto, time);
    }

    /**
     * This method will process a confirmation request asking the user whether
     * or not they wish to proceed.
     *
     * @param frr A reference to a feature request response object
     */
    private void processConfirmationRequest(FeatureRequestResponse frr) {
        DisplayableMessage uiMessage = (DisplayableMessage) frr.getFeatureParameters();
        String msg = uiMessage.getMessageText();
        OptionPaneResponse opr = jAppUIProvider.inlineOptionPaneRequest(
                OptionsPane.PromptType.PROMPT_YES_NO,
                msg);
        BooleanResult result = null;
        if (opr.isYesSelected()) {
            result = new BooleanResult(true);
        } else {
            result = new BooleanResult(false);
        }
        frr.setFeatureResult(result);
        frr.setState(FeatureRequestResponse.State.EXECUTED);
        jUIDelegate.jUIComponent.deliverFeatureResponse(frr);
    }

