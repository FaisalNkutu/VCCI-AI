    public boolean issueFeatureRequest(
            IFRREnabled frrEnabled,
            BrokerKey brokerKey,
            String sourceQualifierName,
            String componentID,
            String featureID,
            BTO featureParameters,
            boolean sendResponse) {
        if (brokerKey == null) {
            jL.error("Null Broker Key for Feature Request. Component ID {}, Feature ID {}, Source Qualifier {}, FRR Caller {}", componentID, featureID, sourceQualifierName, frrEnabled);
            return false;
        }

        return jUIDelegate.issueFeatureRequest(
                frrEnabled,
                brokerKey,
                sourceQualifierName,
                componentID,
                featureID,
                featureParameters,
                sendResponse);
    }

    protected void printQueueDetails(
            String tag,
            LinkedBlockingQueue queue) {

        String s = getQueueString(tag, queue);
        if (jIAdminPanelDataReceiver != null) {
            jIAdminPanelDataReceiver.queuePrint(s);
        }
    }

    private String getQueueString(String tag,
            LinkedBlockingQueue queue) {
        Object[] objs = queue.toArray();
        LinkedHashMap<String, Long> objClassCounter = new LinkedHashMap<>();
        Object o;
        String classname;
        Long counter;
        BTO bto;
        for (int i = 0; i < objs.length; i++) {
            o = objs[i];
            bto = null;
            if (o instanceof DispatchUINotification) {
                DispatchUINotification dui = (DispatchUINotification) o;
                bto = dui.getUINotification().getObject();
            } else {
                DispatchFRR dfrr = (DispatchFRR) o;
                bto = dfrr.getFRR().getFeatureParameters();
            }
            if (bto != null) {
                classname = bto.getClass().getCanonicalName();

                if (objClassCounter.containsKey(classname)) {
                    counter = objClassCounter.get(classname);
                    counter++;
                    objClassCounter.put(classname, counter);
                } else {
                    counter = 1L;
                    objClassCounter.put(classname, counter);
                }
            }
        }
        Set<String> keys = objClassCounter.keySet();
        Iterator<String> iter = keys.iterator();
        StringBuilder s = new StringBuilder("______________________[" + tag + "]__________________________________\n");

        while (iter.hasNext()) {
            classname = iter.next();
            counter = objClassCounter.get(classname);
            s.append("Class[").append(classname).append("] count = ").append(counter).append("\n");
        }
        return s.toString();
    }

    private void recordStat(BTO bto, long time) {
        if (bto != null) {
            String className = bto.getClass().getCanonicalName();
            Stat stat = classStats.get(className);
            if (stat != null) {
                stat.addTime(time);
            } else {
                classStats.put(className, new Stat(time));
            }
        }
    }

    protected void printStats() {
        String timingStats = "______________________[Timing Stats]__________________________________\n";
        for (String className : classStats.keySet()) {
            Stat stat = classStats.get(className);
            timingStats += "Class[" + className + "] \n    count = " + stat.calls + "\n"
                    + "    total time: " + formatTime(stat.totalTime) + "\n"
                    + "    longest time: " + formatTime(stat.longestTime) + "\n"
                    + "    average time: " + formatTime(stat.totalTime / stat.calls) + "\n";
        }

        UIAudit.audit(timingStats, UIAudit.OBJECT_TIMING_STATS);
    }

    private LinkedHashMap<String, Stat> classStats = new LinkedHashMap<>();

    private String formatTime(long millis) {
        long second = (millis / 1000) % 60;
        long minute = (millis / (1000 * 60)) % 60;
        long hour = (millis / (1000 * 60 * 60)) % 24;
        millis = millis % 1000;

        return String.format("%02d:%02d:%02d.%03d", hour, minute, second, millis);
    }

    private class Stat {

        public long calls;
        public long totalTime;
        public long longestTime;

        public Stat(long time) {
            calls = 1;
            totalTime = time;
            longestTime = time;
        }

        public void addTime(long time) {
            calls++;
            totalTime += time;
            if (time > longestTime) {
                longestTime = time;
            }
        }
    }

